---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Naman",
  description = "A photo diary of trips around the world.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem("theme") === "light") {
            document.documentElement.setAttribute("data-theme", "light");
          }
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      // Language filter: swaps any element carrying data-i18n-<lang>
      // attributes to that language's text. Elements marked
      // data-i18n-words hold pipe-separated words and are re-rendered as
      // one <span> per word (used for the stacked city-name headings).
      // Defined here (loaded on every page) so the toggle in the footer
      // works regardless of which page it's clicked from.
      window.__applyLang = function (lang) {
        document.documentElement.setAttribute("data-lang", lang);
        document.querySelectorAll("[data-i18n-" + lang + "]").forEach(function (el) {
          var value = el.getAttribute("data-i18n-" + lang);
          if (el.hasAttribute("data-i18n-words")) {
            el.innerHTML = "";
            value.split("|").forEach(function (word) {
              var span = document.createElement("span");
              span.textContent = word;
              el.appendChild(span);
            });
          } else {
            el.textContent = value;
          }
        });
        // The filter is a radio group: the chosen option is the only one in
        // the tab order, so Tab reaches the row and the arrow keys move
        // within it.
        document.querySelectorAll(".lang-toggle-btn").forEach(function (btn) {
          var active = btn.getAttribute("data-lang") === lang;
          btn.setAttribute("aria-checked", active ? "true" : "false");
          btn.setAttribute("tabindex", active ? "0" : "-1");
        });
      };
      window.__setLang = function (lang) {
        try {
          localStorage.setItem("lang", lang);
        } catch (e) {}
        window.__applyLang(lang);
      };
      document.addEventListener("DOMContentLoaded", function () {
        var lang = "en";
        try {
          lang = localStorage.getItem("lang") || "en";
        } catch (e) {}
        window.__applyLang(lang);
      });
    </script>
  </head>
  <body class="min-h-screen bg-ink font-sans text-[16px] leading-[1.7] text-[var(--color-body)] antialiased">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <ThemeToggle />
  </body>
</html>
