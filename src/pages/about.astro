---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import PageHeading from "../components/PageHeading.astro";
import { about } from "../data/about";
import profile from "../assets/profile.jpg";
---

<Layout title="About — Travel Diary" description={about.bioShort}>
  <!-- Hero -->
  <section class="px-6 pt-16 sm:px-10 sm:pt-24">
    <PageHeading title="about me" subtitle={about.tagline} />
  </section>

  <!-- Two-column bio -->
  <section class="mx-auto max-w-5xl px-6 py-24 sm:px-10">
    <div class="grid gap-10 sm:grid-cols-2 sm:items-center sm:gap-16">
      <div class="overflow-hidden rounded-[16px]">
        <Image
          src={profile}
          alt={about.name}
          width={800}
          class="aspect-[4/5] w-full object-cover"
        />
      </div>
      <div class="space-y-5">
        <p class="text-[17px] leading-[1.7] text-white/75">
          {about.bioShort}
        </p>
        <p class="text-[17px] leading-[1.7] text-white/75">
          {about.bioLong}
        </p>
        <p class="text-[17px] leading-[1.7] text-white/75">
          {about.bioThird}
        </p>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="border-t border-line/70">
    <div class="mx-auto max-w-3xl px-6 py-24 sm:px-10">
      <h2 class="font-heading text-3xl text-paper sm:text-4xl">
        my experience
      </h2>
      <div class="mt-10 space-y-6">
        {
          about.experience.map((job) => (
            <div class="rounded-[12px] border border-white/10 p-7">
              <div class="flex items-start justify-between gap-4">
                <p class="font-medium text-white/90">{job.company}</p>
                <p class="shrink-0 text-[14px] text-white/50">
                  {job.dateRange}
                </p>
              </div>
              <h3 class="mt-3 text-lg font-bold text-paper">{job.title}</h3>
              <p class="mt-2 text-[15px] leading-[1.7] text-white/60">
                {job.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="border-t border-line/70">
    <div class="mx-auto max-w-2xl px-6 py-24 sm:px-10">
      <h2 class="font-heading text-3xl text-paper sm:text-4xl">
        where I've been
      </h2>
      <ol class="mt-10 space-y-8">
        {
          about.timeline.map((stop) => (
            <li class="flex flex-col gap-1 border-b border-line/50 pb-8 last:border-none last:pb-0 sm:flex-row sm:gap-8">
              <span class="font-heading text-2xl text-accent sm:w-20 sm:shrink-0">
                {stop.year}
              </span>
              <div>
                <h3 class="font-heading text-2xl text-paper">{stop.title}</h3>
                <p class="mt-1 text-[16px] leading-[1.7] text-white/75">
                  {stop.description}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Featured -->
  <section class="border-t border-line/70">
    <div class="mx-auto max-w-2xl px-6 py-24 sm:px-10">
      <h2 class="font-heading text-3xl text-paper sm:text-4xl">featured</h2>
      <ul class="mt-10 space-y-4">
        {
          about.featured.map((item) => (
            <li>
              <a
                href={item.href}
                class="group flex items-center justify-between border-b border-line/50 pb-4 text-lg text-paper transition-colors hover:text-accent"
              >
                <span>{item.label}</span>
                <span class="transition-transform group-hover:translate-x-1">
                  &rarr;
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-line/70">
    <div class="mx-auto max-w-2xl px-6 py-24 text-center sm:px-10">
      <a
        href={about.contactHref}
        class="font-heading text-3xl text-paper transition-colors hover:text-accent"
      >
        get in touch &rarr;
      </a>
    </div>
  </section>
</Layout>
