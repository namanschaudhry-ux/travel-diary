---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { about } from "../data/about";
import profile from "../assets/profile.jpg";
---

<Layout title="About — Travel Diary" description={about.bioShort}>
  <!-- Hero -->
  <section class="mx-auto max-w-3xl px-6 pb-16 pt-20 text-center sm:px-10 sm:pt-28">
    <p class="text-xs uppercase tracking-[0.3em] text-accent">About Me</p>
    <h1 class="mt-4 font-serif text-4xl text-paper sm:text-6xl">
      {about.name}
    </h1>
    <p class="mt-3 font-serif text-xl italic text-paper-dim">
      {about.tagline}
    </p>

    <div class="mx-auto mt-10 w-48 overflow-hidden rounded-full border border-line sm:w-56">
      <Image
        src={profile}
        alt={about.name}
        width={400}
        class="aspect-[4/5] w-full object-cover"
      />
    </div>
  </section>

  <!-- Bio -->
  <section class="mx-auto max-w-2xl px-6 pb-20 sm:px-10">
    <p class="text-base leading-relaxed text-paper">
      {about.bioShort}
    </p>
    <p class="mt-6 text-base leading-relaxed text-paper-dim">
      {about.bioLong}
    </p>
  </section>

  <!-- Timeline -->
  <section class="border-t border-line/70">
    <div class="mx-auto max-w-2xl px-6 py-20 sm:px-10">
      <p class="text-xs uppercase tracking-[0.3em] text-accent">Where I've Been</p>
      <ol class="mt-8 space-y-8">
        {
          about.timeline.map((stop) => (
            <li class="flex flex-col gap-1 border-b border-line/50 pb-8 last:border-none last:pb-0 sm:flex-row sm:gap-8">
              <span class="font-serif text-xl text-accent sm:w-20 sm:shrink-0">
                {stop.year}
              </span>
              <div>
                <h3 class="font-serif text-2xl text-paper">{stop.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-paper-dim">
                  {stop.description}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Featured -->
  <section class="border-t border-line/70">
    <div class="mx-auto max-w-2xl px-6 py-20 sm:px-10">
      <p class="text-xs uppercase tracking-[0.3em] text-accent">Featured</p>
      <ul class="mt-8 space-y-4">
        {
          about.featured.map((item) => (
            <li>
              <a
                href={item.href}
                class="group flex items-center justify-between border-b border-line/50 pb-4 text-lg text-paper transition-colors hover:text-accent"
              >
                <span>{item.label}</span>
                <span class="transition-transform group-hover:translate-x-1">
                  &rarr;
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-line/70">
    <div class="mx-auto max-w-2xl px-6 py-20 text-center sm:px-10">
      <a
        href={about.contactHref}
        class="font-serif text-2xl text-paper transition-colors hover:text-accent"
      >
        Get in touch &rarr;
      </a>
    </div>
  </section>
</Layout>
