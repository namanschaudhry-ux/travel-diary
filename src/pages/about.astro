---
import Layout from "../layouts/Layout.astro";
import PageHeading from "../components/PageHeading.astro";
---

<Layout title="About — Naman Chaudhry" description="A bit about me.">
  <section class="mx-auto max-w-3xl px-6 pt-16 sm:px-10 sm:pt-24">
    <PageHeading
      title="about me"
      subtitle="operator, builder, occasional traveller"
    />
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-24 sm:px-10">
    <h2 class="mb-8 font-heading text-[36px] lowercase text-paper">my experience</h2>

    <div class="flex flex-col gap-5">

      <!-- VXT -->
      <div class="rounded-[12px] border border-[var(--color-card-border)] p-7">
        <div class="flex items-start justify-between gap-4">
          <span class="font-sans text-sm font-semibold uppercase tracking-[0.15em] text-accent">VXT</span>
          <span class="shrink-0 font-sans text-sm text-[var(--color-muted-40)]">Mar 2025 – Present</span>
        </div>
        <p class="mt-2 font-sans text-[15px] font-semibold text-paper">Head of Finance</p>
        <p class="mt-3 text-[15px] leading-[1.7] text-[var(--color-muted-60)]">
          Employee #19 and first ops hire at a Series A legal-tech startup. Led a $10m+ debt and equity raise from institutional VCs, and built internal finance and people ops systems from scratch — accounts receivable, payable, treasury, employee spend, and ESOP — as the company scaled from $1m to $7m ARR.
        </p>
      </div>

      <!-- coffeepass -->
      <div class="rounded-[12px] border border-[var(--color-card-border)] p-7">
        <div class="flex items-start justify-between gap-4">
          <span class="font-sans text-sm font-semibold uppercase tracking-[0.15em] text-accent">coffeepass</span>
          <span class="shrink-0 font-sans text-sm text-[var(--color-muted-40)]">Dec 2023 – Feb 2025</span>
        </div>
        <p class="mt-2 font-sans text-[15px] font-semibold text-paper">Co-Founder</p>
        <p class="mt-3 text-[15px] leading-[1.7] text-[var(--color-muted-60)]">
          Built a subscription network for barista coffee in New York City. Grew to $100k ARR and 100+ partner cafes, increasing individual cafe sales by up to 48%. Led the sales motion with a team of four interns and shipped an Apple Wallet coffee subscription card using no-code tools.
        </p>
      </div>

      <!-- Airwallex -->
      <div class="rounded-[12px] border border-[var(--color-card-border)] p-7">
        <div class="flex items-start justify-between gap-4">
          <span class="font-sans text-sm font-semibold uppercase tracking-[0.15em] text-accent">Airwallex</span>
          <span class="shrink-0 font-sans text-sm text-[var(--color-muted-40)]">Mar 2022 – Nov 2023</span>
        </div>
        <p class="mt-2 font-sans text-[15px] font-semibold text-paper">Sales Strategy & Operations Lead</p>
        <p class="mt-3 text-[15px] leading-[1.7] text-[var(--color-muted-60)]">
          First ops hire in the US at a $10b+ fintech. Delivered 280% gross profit growth in six months by removing operational bottlenecks across onboarding, pricing, and territory. Spearheaded the Canada GTM launch and advised the executive team on US go-to-market strategy using advanced SQL analyses.
        </p>
      </div>

      <!-- Blackbird Ventures -->
      <div class="rounded-[12px] border border-[var(--color-card-border)] p-7">
        <div class="flex items-start justify-between gap-4">
          <span class="font-sans text-sm font-semibold uppercase tracking-[0.15em] text-accent">Blackbird Ventures</span>
          <span class="shrink-0 font-sans text-sm text-[var(--color-muted-40)]">Aug 2021 – Dec 2021</span>
        </div>
        <p class="mt-2 font-sans text-[15px] font-semibold text-paper">Portfolio Analyst</p>
        <p class="mt-3 text-[15px] leading-[1.7] text-[var(--color-muted-60)]">
          Analysed financial and operational data across a portfolio of 85+ early-stage startups at one of Australia's largest VC funds (US$4b+ FUM). Scaled and automated internal data collection and built portfolio visualisations in Tableau.
        </p>
      </div>

    </div>
  </section>
</Layout>
