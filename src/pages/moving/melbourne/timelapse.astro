---
// Draft (Nov 2026): the Melbourne run map filling up month by month.
// Not linked from anywhere yet; /moving/melbourne/timelapse/ for review.
import Layout from "../../../layouts/Layout.astro";
import RunTimelapse from "../../../components/RunTimelapse.astro";
---

<Layout title="Melbourne, run by run — Naman Chaudhry" description="Every run around Melbourne's CBD, drawn onto the map in the order they happened.">
  <section class="mx-auto max-w-6xl px-4 pt-8 pb-16 sm:px-10">
    <a href="/moving/melbourne/" class="font-sans text-xs uppercase tracking-[0.15em] text-[var(--color-muted-60)] hover:text-accent">← melbourne</a>
    <div class="mt-8 mb-8 flex flex-col items-center gap-1 text-center">
      <h1 class="font-sans text-xs font-semibold uppercase tracking-[0.12em] text-accent">Melbourne, run by run</h1>
      <p class="mt-2 font-sans text-[11px] uppercase tracking-[0.15em] text-[var(--color-muted-40)]">Every run on this map, in the order they happened</p>
    </div>
    <RunTimelapse city="Melbourne" frameCenter={[-37.815, 144.965]} frameCenterRadiusKm={3.5} />
  </section>
</Layout>
