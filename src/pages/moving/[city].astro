---
// One page per city that has hand-picked routes (src/data/city-routes.ts),
// e.g. /moving/new-york/. Linked from the city cards on the Moving page.
// Routes are drawn in full, start and finish included.
import Layout from "../../layouts/Layout.astro";
import { cityActivity } from "../../data/activity-summary";
import { cityRoutes, citySlug, type CityRoute } from "../../data/city-routes";
import "leaflet/dist/leaflet.css";

export function getStaticPaths() {
  return Object.entries(cityRoutes)
    .filter(([, routes]) => routes.length > 0)
    .map(([city, routes]) => ({ params: { city: citySlug(city) }, props: { city, routes } }));
}

const { city, routes } = Astro.props as { city: string; routes: CityRoute[] };
const country = cityActivity.find((c) => c.city === city)?.country ?? "";
const fmt = (n: number) => n.toLocaleString("en-US", { maximumFractionDigits: 1 });
const routeDate = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString("en-AU", { day: "numeric", month: "short", year: "numeric" });
---

<Layout title={`${city} routes — Naman Chaudhry`} description={`Routes run, ridden and walked in ${city}.`}>
  <section class="mx-auto max-w-6xl px-6 pt-8 sm:px-10">
    <a href="/moving/" class="back-link font-sans text-xs uppercase tracking-[0.15em] text-[var(--color-muted-60)] hover:text-accent">← moving</a>
    <div class="mt-8 flex flex-col items-center gap-1 text-center">
      <h1 class="font-sans text-xs font-semibold uppercase tracking-[0.12em] text-accent">{city}</h1>
      <span class="font-sans text-xs text-[var(--color-muted-40)]">{country}</span>
      <p class="mt-2 font-sans text-[11px] uppercase tracking-[0.15em] text-[var(--color-muted-40)]">
        {routes.length} {routes.length === 1 ? "route" : "routes"}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pt-8 pb-16 sm:px-10">
    <div id="route-map" data-routes={JSON.stringify(routes)} aria-label={`Map of routes in ${city}`}></div>
    <ul class="route-list">
      {routes.map((route) => (
        <li class="route-item rounded-[12px] border border-[var(--color-card-border)] p-5">
          <span class="route-name">{route.name}</span>
          <span class="route-meta">{route.sport.toLowerCase()} · {routeDate(route.date)} · {fmt(route.distanceKm)} km · {route.elevationM} m up</span>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<script>
  import L from "leaflet";
  const target = document.getElementById("route-map");
  if (target) {
    const routes: { points: [number, number][] }[] = JSON.parse(target.dataset.routes ?? "[]");
    const accent = getComputedStyle(document.documentElement).getPropertyValue("--color-accent").trim() || "#b08968";
    const map = L.map(target, { scrollWheelZoom: false });
    L.tileLayer("https://maps.wikimedia.org/osm-intl/{z}/{x}/{y}{r}.png", {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map);
    const bounds = L.latLngBounds([]);
    routes.forEach((route) => {
      const line = L.polyline(route.points, { color: accent, weight: 4, opacity: 0.95, lineCap: "round" }).addTo(map);
      bounds.extend(line.getBounds());
      L.circleMarker(route.points[0], { radius: 6, color: "#0d0d0d", weight: 2, fillColor: "#5cc47a", fillOpacity: 1 }).bindTooltip("start").addTo(map);
      L.circleMarker(route.points[route.points.length - 1], { radius: 6, color: "#0d0d0d", weight: 2, fillColor: "#e0605a", fillOpacity: 1 }).bindTooltip("finish").addTo(map);
    });
    if (bounds.isValid()) map.fitBounds(bounds, { padding: [32, 32] });
  }
</script>

<style>
  #route-map {
    height: min(70vh, 640px);
    min-height: 360px;
    border-radius: 12px;
    border: 1px solid var(--color-card-border);
    overflow: hidden;
    z-index: 0;
  }
  #route-map :global(.leaflet-tile-pane) { filter: grayscale(0.85) brightness(0.8) contrast(1.05); }
  :global(:root[data-theme="light"]) #route-map :global(.leaflet-tile-pane) { filter: grayscale(0.85); }
  .route-list { margin: 20px 0 0; padding: 0; list-style: none; display: grid; gap: 12px; }
  .route-item { display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: baseline; }
  .route-name { font: 600 14px var(--font-sans); color: var(--color-paper); }
  .route-meta { font: 12px / 1.5 monospace; letter-spacing: .04em; color: var(--color-muted-60); }
</style>
