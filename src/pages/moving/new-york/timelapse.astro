---
// Draft (Nov 2026): the New York run map filling up trip by trip.
// Not linked from anywhere yet; /moving/new-york/timelapse/ for review.
// Months without runs are left out, so it goes straight from one trip to the next.
import Layout from "../../../layouts/Layout.astro";
import RunTimelapse from "../../../components/RunTimelapse.astro";
---

<Layout title="New York, run by run — Naman Chaudhry" description="Every run in New York, drawn onto the map trip by trip.">
  <section class="mx-auto max-w-6xl px-4 pt-8 pb-16 sm:px-10">
    <a href="/moving/new-york/" class="font-sans text-xs uppercase tracking-[0.15em] text-[var(--color-muted-60)] hover:text-accent">← new york</a>
    <div class="mt-8 mb-8 flex flex-col items-center gap-1 text-center">
      <h1 class="font-sans text-xs font-semibold uppercase tracking-[0.12em] text-accent">New York, run by run</h1>
      <p class="mt-2 font-sans text-[11px] uppercase tracking-[0.15em] text-[var(--color-muted-40)]">Every run, trip by trip, in the order they happened</p>
    </div>
    <RunTimelapse city="New York" seconds={36} skipEmptyMonths />
  </section>
</Layout>
