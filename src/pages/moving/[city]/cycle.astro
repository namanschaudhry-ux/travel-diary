---
// One page per city that has hand-picked rides (cityRideRoutes in
// src/data/city-routes.ts), e.g. /moving/melbourne/cycle/. Linked from the
// city cards on the Moving page when the cycle filter is on.
import CityRoutesPage from "../../../components/CityRoutesPage.astro";
import { cityRideRoutes, citySlug, type CityRoute } from "../../../data/city-routes";

export function getStaticPaths() {
  return Object.entries(cityRideRoutes)
    .filter(([, routes]) => routes.length > 0)
    .map(([city, routes]) => ({ params: { city: citySlug(city) }, props: { city, routes } }));
}

const { city, routes } = Astro.props as { city: string; routes: CityRoute[] };
---

<CityRoutesPage city={city} routes={routes} sport="cycle" />
