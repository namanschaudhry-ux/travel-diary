---
import Layout from "../../layouts/Layout.astro";
import Gallery from "../../components/Gallery.astro";
import PageHeading from "../../components/PageHeading.astro";
import { destinations } from "../../data/destinations";
import { getPhotos } from "../../lib/gallery";

export function getStaticPaths() {
  return destinations.map((d) => ({
    params: { slug: d.slug },
    props: { destination: d },
  }));
}

const { destination } = Astro.props;
const photos = getPhotos(destination.slug);
---

<Layout
  title={`${destination.name} — Travel Diary`}
  description={destination.blurb}
>
  <section class="mx-auto max-w-3xl px-6 pt-16 text-center sm:px-10 sm:pt-24">
    <a
      href="/"
      class="text-sm lowercase text-paper-dim transition-colors hover:text-accent"
    >
      &larr; all destinations
    </a>
    <PageHeading
      title={destination.name}
      subtitle={`${destination.country} · ${destination.year}`}
    />
    <p class="mx-auto max-w-md text-[16px] leading-[1.7] text-white/75">
      {destination.blurb}
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-24 sm:px-10">
    {
      photos.length > 0 ? (
        <Gallery photos={photos} alt={destination.name} />
      ) : (
        <p class="text-[16px] leading-[1.7] text-white/75">
          No photos yet — add some to{" "}
          <code class="text-accent">
            src/assets/photos/{destination.slug}/
          </code>
          .
        </p>
      )
    }
  </section>
</Layout>
