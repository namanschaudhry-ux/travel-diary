---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { cityActivity, activityTotals as totals } from "../data/activity-summary";
import { cityRoutes } from "../data/city-routes";
import "leaflet/dist/leaflet.css";
import novablast5WinterSea from "../assets/shoes/novablast-5-winter-sea.png";
import novablast5Tokyo from "../assets/shoes/novablast-5-tokyo.png";
import novablast5PurpleRed from "../assets/shoes/novablast-5-purple-red.png";
import zoomFly6Kipchoge from "../assets/shoes/zoom-fly-6-kipchoge.png";
import nimbus22RedBlack from "../assets/shoes/nimbus-22-red-black.png";
import nbNycMarathon2024 from "../assets/shoes/nb-nyc-marathon-2024.png";
import nimbusPlatinum from "../assets/shoes/nimbus-25-platinum.png";
import nimbusGreyBlue from "../assets/shoes/nimbus-25-grey-blue.png";
import novablastOrange from "../assets/shoes/novablast-4-orange.png";
import novablastParis from "../assets/shoes/novablast-4-paris.png";
import tarmacSl7 from "../assets/bike/tarmac-sl7-sport-black.png";

const shoes = [
  { image: novablast5WinterSea, alt: "ASICS Novablast 5 in the Winter Sea/Stillwater colorway.", label: "Novablast 5", sub: "Winter Sea", year: "2023" },
  { image: novablast5Tokyo, alt: "ASICS Novablast 5 in the Tokyo colorway, made for the Tokyo Marathon.", label: "Novablast 5", sub: "Tokyo", year: "2023" },
  { image: novablast5PurpleRed, alt: "ASICS Novablast 5 in the Purple/Red colorway.", label: "Novablast 5", sub: "Purple / Red", year: "2023" },
  { image: zoomFly6Kipchoge, alt: "Nike Zoom Fly 6, Eliud Kipchoge 'No Human Is Limited' edition.", label: "Zoom Fly 6", sub: "Eliud Kipchoge", year: "2023" },
  { image: nimbus22RedBlack, alt: "ASICS GEL-Nimbus 22 in the Classic Red/Black colorway.", label: "GEL-Nimbus 22", sub: "Red / Black", year: "2023" },
  { image: nbNycMarathon2024, alt: "New Balance FuelCell SuperComp Elite v4, 2024 TCS New York City Marathon edition.", label: "New Balance", sub: "NYC Marathon 2024", year: "2023" },
  { image: nimbusPlatinum, alt: "ASICS GEL-Nimbus 25 in the Platinum Black/Pure Silver colorway.", label: "GEL-Nimbus 25", sub: "Platinum", year: "2023" },
  { image: nimbusGreyBlue, alt: "ASICS GEL-Nimbus 25 in the Sheet Rock/Indigo Blue colorway.", label: "GEL-Nimbus 25", sub: "Sheet Rock Indigo", year: "2023" },
  { image: novablastOrange, alt: "ASICS Novablast 4 in the Bright Sunstone orange colorway.", label: "Novablast 4", sub: "Bright Sunstone", year: "2023" },
  { image: novablastParis, alt: "ASICS Novablast 4 in the Paris Olympics Cool Matcha/Safety Yellow colorway.", label: "Novablast 4", sub: "Paris", year: "2023" },
];

const cities = [...cityActivity]
  .map((c) => ({ ...c, total: c.run + c.cycle + c.swim }))
  .sort((a, b) => b.total - a.total);

const routeDate = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString("en-AU", { day: "numeric", month: "short", year: "numeric" });

const fmt = (n: number) => n.toLocaleString("en-US", { maximumFractionDigits: 1 });

const typeRows = (c: (typeof cities)[number]) =>
  [
    { label: "run", value: c.run },
    { label: "cycle", value: c.cycle },
    { label: "swim", value: c.swim },
  ].filter((row) => row.value >= 10);

const filters = ["run", "cycle", "swim"];
---

<Layout title="On the move — Naman Chaudhry" description="Kilometres logged by city, pulled from Strava.">
  <section class="mx-auto flex max-w-6xl justify-center gap-2 px-6 pt-8 pb-8 sm:px-10 sm:pt-10">
    {
      filters.map((f) => (
        <button
          type="button"
          data-filter-btn={f}
          aria-pressed={f === "run" ? "true" : "false"}
          class:list={[
            "rounded-[8px] border px-4 py-1.5 font-sans text-xs uppercase tracking-[0.15em] transition-colors",
            f === "run"
              ? "border-accent text-accent"
              : "border-[var(--color-card-border)] text-[var(--color-muted-60)] hover:border-[var(--color-muted-40)] hover:text-paper",
          ]}
        >
          {f}
        </button>
      ))
    }
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-8 sm:px-10">
    <div
      id="top-strip"
      class="relative isolate flex flex-wrap rounded-[12px] border border-[var(--color-card-border)] overflow-hidden"
    >
      <div id="city-fill" aria-hidden="true"></div>
      {
        [
          { label: "run", value: totals.run },
          { label: "cycle", value: totals.cycle },
          { label: "swim", value: totals.swim },
        ].map((t) => (
          <div class="relative flex-1 p-6 text-center" data-total={t.value} data-sport={t.label} hidden={t.label !== "run"}>
            <p class="font-sans font-medium tracking-tight text-4xl text-paper">
              {fmt(t.value)}<span class="font-sans font-normal text-base text-[var(--color-muted-40)]"> km</span>
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-6 pb-8 sm:px-10" id="view-toggle-wrap">
    <div class="filter-wheel-wrap mx-auto">
      <div class="filter-wheel" id="view-wheel" role="tablist" aria-label="City or gear view">
        {["city", "gear"].map((label) => (
          <button type="button" class="filter-item" role="tab" data-view={label} aria-selected={label === "city" ? "true" : "false"}>{label}</button>
        ))}
      </div>
    </div>
  </div>

  <section class="mx-auto max-w-6xl px-6 pb-16 sm:px-10" data-view-section="city">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        cities.map((c) => (
          <div
            class="city-card rounded-[12px] border border-[var(--color-card-border)] p-6 text-center"
            data-city-card
            data-has-routes={cityRoutes[c.city]?.length ? "true" : undefined}
            role={cityRoutes[c.city]?.length ? "button" : undefined}
            aria-expanded={cityRoutes[c.city]?.length ? "false" : undefined}
            aria-label={cityRoutes[c.city]?.length ? `${c.city}: show routes on a map` : undefined}
            tabindex="0"
            data-sports={typeRows(c)
              .map((r) => r.label)
              .join(" ")}
            hidden={!typeRows(c).some((r) => r.label === "run")}
          >
            <div class="flex flex-col items-center gap-1">
              <span class="city-name font-sans text-xs font-semibold uppercase tracking-[0.12em] text-accent">{c.city}</span>
              <span class="font-sans text-xs text-[var(--color-muted-40)]">{c.country}</span>
            </div>
            <div class="mt-4 flex flex-wrap justify-center gap-6">
              {typeRows(c).map((row) => (
                <div data-distance={row.value} data-sport={row.label} hidden={row.label !== "run"}>
                  <p class="font-sans font-medium tracking-tight text-2xl text-paper">
                    {fmt(row.value)}<span class="font-sans font-normal text-sm text-[var(--color-muted-40)]"> km</span>
                  </p>
                </div>
              ))}
            </div>
            {cityRoutes[c.city]?.length ? (
              <>
                <p class="route-hint mt-4 font-sans text-[11px] uppercase tracking-[0.15em] text-[var(--color-muted-40)]">
                  {cityRoutes[c.city].length} {cityRoutes[c.city].length === 1 ? "route" : "routes"} · <span class="route-hint-action">view map</span>
                </p>
                <div class="route-panel" hidden data-routes={JSON.stringify(cityRoutes[c.city])}>
                  <div class="route-map" aria-label={`Map of routes in ${c.city}`}></div>
                  <ul class="route-list">
                    {cityRoutes[c.city].map((route) => (
                      <li>
                        <span class="route-name">{route.name}</span>
                        <span class="route-meta">{route.sport.toLowerCase()} · {routeDate(route.date)} · {fmt(route.distanceKm)} km · {route.elevationM} m up</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </>
            ) : null}
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-16 sm:px-10" data-view-section="gear" data-sport-section="run" hidden>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        shoes.map((shoe) => (
          <div
            class="city-card rounded-[12px] border border-[var(--color-card-border)] p-6 text-center"
            data-gear-card
            tabindex="0"
            data-distance={totals.run / shoes.length}
          >
            <figcaption class="shoe-caption mb-2 font-sans text-sm font-light text-paper/90">
              <span class="block">{shoe.label}</span>
              <span class="block">{shoe.sub}</span>
            </figcaption>
            <Image src={shoe.image} alt={shoe.alt} widths={[240, 360, 480]} sizes="(min-width: 640px) 280px, 55vw" format="webp" class="mx-auto h-auto w-full max-w-[280px]" />
            <p class="shoe-caption mt-2 font-sans text-sm font-light text-paper/90">{shoe.year}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-16 sm:px-10" data-view-section="gear" data-sport-section="cycle" hidden>
    <div
      class="city-card mx-auto max-w-sm rounded-[12px] border border-[var(--color-card-border)] p-6 text-center"
      data-gear-card
      tabindex="0"
      data-distance={totals.cycle}
    >
      <Image src={tarmacSl7} alt="Specialized Tarmac SL7 Sport road bike in black." widths={[240, 360, 480]} sizes="(min-width: 640px) 280px, 60vw" format="webp" class="mx-auto h-auto w-full max-w-[280px]" />
      <div class="mt-3 flex flex-col gap-0.5">
        <span class="city-name font-sans text-xs font-semibold uppercase tracking-[0.12em] text-accent">Specialized Tarmac SL7</span>
        <span class="font-sans text-xs text-[var(--color-muted-40)]">Sport, Black</span>
      </div>
    </div>
  </section>
</Layout>

<script>
  const ACTIVE =
    "rounded-[8px] border px-4 py-1.5 font-sans text-xs uppercase tracking-[0.15em] transition-colors border-accent text-accent";
  const INACTIVE =
    "rounded-[8px] border px-4 py-1.5 font-sans text-xs uppercase tracking-[0.15em] transition-colors border-[var(--color-card-border)] text-[var(--color-muted-60)] hover:border-[var(--color-muted-40)] hover:text-paper";

  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter-btn]");
  const cityCards = document.querySelectorAll<HTMLElement>("[data-city-card]");
  const viewToggleWrap = document.getElementById("view-toggle-wrap");

  const fill = document.querySelector<HTMLElement>("#city-fill");
  let selectedSport = "run";
  let selectedView = "city";
  let hoveredCard: HTMLElement | null = null;
  let focusedCard: HTMLElement | null = null;

  function cardDistance(card: HTMLElement): number {
    if (card.hasAttribute("data-gear-card")) return Number(card.dataset.distance ?? 0);
    return Number(card.querySelector<HTMLElement>(`[data-sport="${selectedSport}"]`)?.dataset.distance ?? 0);
  }

  function updateFill() {
    const card = hoveredCard ?? focusedCard;
    const distance = card ? cardDistance(card) : 0;
    const total = Number(document.querySelector<HTMLElement>(`#top-strip [data-sport="${selectedSport}"]`)?.dataset.total ?? 0);
    const share = total > 0 ? Math.min(1, Math.max(0, distance / total)) : 0;
    fill?.style.setProperty("--city-share", String(share));
  }

  function trackDistanceCard(card: HTMLElement) {
    card.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "touch") return;
      hoveredCard = card;
      updateFill();
    });
    card.addEventListener("pointerleave", () => {
      if (hoveredCard === card) hoveredCard = null;
      updateFill();
    });
    card.addEventListener("focus", () => { focusedCard = card; updateFill(); });
    card.addEventListener("blur", () => { focusedCard = null; updateFill(); });
  }

  cityCards.forEach(trackDistanceCard);
  document.querySelectorAll<HTMLElement>("[data-gear-card]").forEach(trackDistanceCard);

  function updateVisibility() {
    document.querySelectorAll<HTMLElement>("[data-view-section]").forEach((el) => {
      const sportMatches = !el.dataset.sportSection || el.dataset.sportSection === selectedSport;
      el.hidden = el.dataset.viewSection !== selectedView || !sportMatches;
    });
    if (viewToggleWrap) viewToggleWrap.hidden = selectedSport === "swim";
  }

  function applyFilter(filter: string) {
    selectedSport = filter;
    hoveredCard = null;
    focusedCard = null;
    if (filter === "swim") selectedView = "city";
    updateFill();
    buttons.forEach((btn) => {
      const isActive = btn.dataset.filterBtn === filter;
      btn.className = isActive ? ACTIVE : INACTIVE;
      btn.setAttribute("aria-pressed", String(isActive));
    });

    document.querySelectorAll<HTMLElement>("#top-strip [data-sport]").forEach((el) => {
      el.hidden = el.dataset.sport !== filter;
    });

    cityCards.forEach((card) => {
      const sports = (card.dataset.sports ?? "").split(" ");
      card.hidden = !sports.includes(filter);
      card.querySelectorAll<HTMLElement>("[data-sport]").forEach((el) => {
        el.hidden = el.dataset.sport !== filter;
      });
    });

    if (filter === "swim") resetViewToCity();
    updateVisibility();
  }

  let resetViewToCity: () => void = () => {};

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => applyFilter(btn.dataset.filterBtn ?? "run"));
  });

  const viewWheel = document.getElementById("view-wheel");
  let setView: (view: string) => void = () => {};
  if (viewWheel) {
    const viewItems = Array.from(viewWheel.querySelectorAll<HTMLButtonElement>(".filter-item"));

    setView = (view: string) => {
      selectedView = view;
      viewItems.forEach((item) => item.setAttribute("aria-selected", String(item.dataset.view === view)));
      updateVisibility();
    };

    resetViewToCity = () => {
      const cityItem = viewItems.find((item) => item.dataset.view === "city");
      cityItem?.scrollIntoView({ behavior: "instant", inline: "center", block: "nearest" });
      setView("city");
    };

    const updateActive = () => {
      const wheelRect = viewWheel.getBoundingClientRect();
      const center = wheelRect.left + wheelRect.width / 2;
      let closest: HTMLButtonElement | null = null;
      let closestDistance = Infinity;
      viewItems.forEach((item) => {
        const itemRect = item.getBoundingClientRect();
        const itemCenter = itemRect.left + itemRect.width / 2;
        const distance = Math.abs(itemCenter - center);
        const proximity = Math.max(0, 1 - distance / (wheelRect.width / 2));
        item.style.opacity = String(0.3 + proximity * 0.7);
        item.style.transform = `scale(${0.82 + proximity * 0.18})`;
        if (distance < closestDistance) {
          closestDistance = distance;
          closest = item;
        }
      });
      if (closest) setView(closest.dataset.view ?? "city");
    };

    let frame: number | undefined;
    const scheduleUpdate = () => {
      if (frame !== undefined) return;
      frame = requestAnimationFrame(() => {
        frame = undefined;
        updateActive();
      });
    };

    viewWheel.addEventListener("scroll", scheduleUpdate, { passive: true });
    window.addEventListener("resize", scheduleUpdate);

    // A vertical page-scroll gesture over this horizontal wheel would otherwise get
    // redirected into scrollLeft (since the wheel has no vertical overflow of its own),
    // silently flipping the selected view. Let vertical-dominant gestures pass through
    // to the page instead.
    viewWheel.addEventListener(
      "wheel",
      (event) => {
        if (Math.abs(event.deltaY) > Math.abs(event.deltaX)) {
          event.preventDefault();
          window.scrollBy({ top: event.deltaY });
        }
      },
      { passive: false }
    );

    viewItems.forEach((item) => {
      item.addEventListener("click", () => {
        item.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
        setView(item.dataset.view ?? "city");
      });
    });

    updateActive();
  }

  updateVisibility();
</script>

<style>
  #city-fill {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transform-origin: left center;
    transform: scaleX(var(--city-share, 0));
    background: color-mix(in srgb, var(--color-accent) 48%, transparent);
    border-right: 1px solid color-mix(in srgb, var(--color-accent) 50%, transparent);
    transition: transform 1000ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .city-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .city-card {
    transition: transform 240ms ease, border-color 240ms ease, background-color 240ms ease, box-shadow 240ms ease;
  }

  .city-name {
    transition: transform 240ms ease, font-weight 240ms ease;
  }

  .shoe-caption {
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 240ms ease, transform 240ms ease;
  }
  .city-card:hover .shoe-caption,
  .city-card:focus-visible .shoe-caption {
    opacity: 1;
    transform: translateY(0);
  }
  @media (hover: none) {
    .shoe-caption {
      opacity: 1;
      transform: none;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .city-card:hover {
      transform: translateY(-4px) scale(1.035);
      border-color: var(--color-accent);
      background-color: color-mix(in srgb, var(--color-accent) 7%, var(--color-ink));
      box-shadow: 0 14px 32px rgb(0 0 0 / 12%);
    }

    .city-card:hover .city-name {
      transform: scale(1.06);
      font-weight: 800;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .city-card, .city-name, #city-fill, .shoe-caption {
      transition: none;
    }
    .city-card:hover, .city-card:hover .city-name {
      transform: none;
    }
    .shoe-caption {
      transform: none;
    }
  }

  .filter-wheel-wrap {
    max-width: 220px;
    min-width: 0;
    overflow: hidden;
  }
  .filter-wheel {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-inline: calc(50% - 45px);
  }
  .filter-wheel::-webkit-scrollbar {
    display: none;
  }
  .filter-item {
    flex: 0 0 90px;
    scroll-snap-align: center;
    appearance: none;
    -webkit-appearance: none;
    background: none;
    border: none;
    box-shadow: none;
    outline: none;
    padding: 6px 0;
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: 16px;
    text-align: center;
    color: var(--color-paper);
    cursor: pointer;
    opacity: 0.3;
    transform: scale(0.82);
    transition: opacity 200ms ease, transform 200ms ease, color 200ms ease;
  }
  .filter-item:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .filter-item[aria-selected="true"] {
    color: var(--color-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .filter-wheel {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  // City route maps: a card with routes opens in place, spanning the grid,
  // and draws its routes with Leaflet. The map is built on first open.
  import L from "leaflet";

  const routeCards = document.querySelectorAll<HTMLElement>("[data-has-routes]");
  const maps = new WeakMap<HTMLElement, L.Map>();

  function drawMap(card: HTMLElement) {
    const panel = card.querySelector<HTMLElement>(".route-panel");
    const target = panel?.querySelector<HTMLElement>(".route-map");
    if (!panel || !target) return;
    const existing = maps.get(card);
    if (existing) {
      existing.invalidateSize();
      return;
    }
    const routes: { points: [number, number][] }[] = JSON.parse(panel.dataset.routes ?? "[]");
    const accent = getComputedStyle(document.documentElement).getPropertyValue("--color-accent").trim() || "#b08968";
    const map = L.map(target, { scrollWheelZoom: false, attributionControl: true });
    L.tileLayer("https://maps.wikimedia.org/osm-intl/{z}/{x}/{y}{r}.png", {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map);
    const bounds = L.latLngBounds([]);
    routes.forEach((route) => {
      const line = L.polyline(route.points, { color: accent, weight: 4, opacity: 0.95, lineCap: "round" }).addTo(map);
      bounds.extend(line.getBounds());
      const start = route.points[0];
      const end = route.points[route.points.length - 1];
      L.circleMarker(start, { radius: 6, color: "#0d0d0d", weight: 2, fillColor: "#5cc47a", fillOpacity: 1 }).bindTooltip("start").addTo(map);
      L.circleMarker(end, { radius: 6, color: "#0d0d0d", weight: 2, fillColor: "#e0605a", fillOpacity: 1 }).bindTooltip("finish").addTo(map);
    });
    map.fitBounds(bounds, { padding: [24, 24] });
    maps.set(card, map);
  }

  function setOpen(card: HTMLElement, open: boolean) {
    const panel = card.querySelector<HTMLElement>(".route-panel");
    if (!panel) return;
    card.classList.toggle("is-open", open);
    card.setAttribute("aria-expanded", String(open));
    panel.hidden = !open;
    const action = card.querySelector(".route-hint-action");
    if (action) action.textContent = open ? "hide map" : "view map";
    if (open) {
      requestAnimationFrame(() => {
        drawMap(card);
        card.scrollIntoView({ block: "nearest", behavior: "smooth" });
      });
    }
  }

  routeCards.forEach((card) => {
    card.addEventListener("click", (event) => {
      // Panning or zooming the map should not close the card.
      if ((event.target as HTMLElement).closest(".route-panel")) return;
      setOpen(card, !card.classList.contains("is-open"));
    });
    card.addEventListener("keydown", (event) => {
      if (event.target !== card) return;
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        setOpen(card, !card.classList.contains("is-open"));
      } else if (event.key === "Escape" && card.classList.contains("is-open")) {
        setOpen(card, false);
      }
    });
  });
</script>

<style>
  [data-has-routes] { cursor: pointer; }
  [data-has-routes].is-open { grid-column: 1 / -1; cursor: default; }
  [data-has-routes].is-open > :not(.route-panel) { cursor: pointer; }
  .route-hint-action { color: var(--color-accent); }
  .route-panel { margin-top: 20px; text-align: left; }
  .route-map {
    height: min(60vh, 520px);
    min-height: 320px;
    border-radius: 8px;
    border: 1px solid var(--color-card-border);
    overflow: hidden;
    z-index: 0;
  }
  .route-map :global(.leaflet-tile-pane) { filter: grayscale(0.85) brightness(0.8) contrast(1.05); }
  :global(:root[data-theme="light"]) .route-map :global(.leaflet-tile-pane) { filter: grayscale(0.85); }
  .route-list { margin: 14px 0 0; padding: 0; list-style: none; }
  .route-list li { display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; }
  .route-name { font: 600 13px var(--font-sans); color: var(--color-paper); }
  .route-meta { font: 12px / 1.5 monospace; letter-spacing: .04em; color: var(--color-muted-60); }
</style>
