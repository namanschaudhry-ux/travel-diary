  }
  .filter-item:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .filter-item[aria-selected="true"] {
    color: var(--color-accent);
  }
  @media (prefers-reduced-motion: reduce) {
