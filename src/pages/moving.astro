<script>
  // Routes view filters. Distance (all, marathons, 30k+, 25k+, 20k+), type
  // (all or races only) and city combine. Distances are compared as shown on the cards,
  // to one decimal place, so a 19.98 km run counts as 20k+.
  const MARATHON_KM = 42;
  const filters: Record<string, string> = { distance: "all", type: "all", city: "all" };
  const routeCount = document.getElementById("route-count");
  const routeCards = Array.from(document.querySelectorAll<HTMLElement>('[data-view-section="routes"][data-sport-section="run"] .route-card'));

  const applyRouteFilters = () => {
    let shown = 0;
    routeCards.forEach((card) => {
      const km = Math.round(Number(card.dataset.km ?? 0) * 10) / 10;
      const minKm = filters.distance === "all" ? 0 : filters.distance === "marathon" ? MARATHON_KM : Number(filters.distance);
      const visible = km >= minKm && (filters.type !== "races" || card.dataset.race === "true") && (filters.city === "all" || card.dataset.city === filters.city);
      card.hidden = !visible;
      if (visible) shown += 1;
    });
    if (routeCount) {
      const noun = filters.type === "races" ? (shown === 1 ? "race" : "races") : (shown === 1 ? "route" : "routes");
      routeCount.textContent = shown === 0 ? `No ${filters.type === "races" ? "races" : "routes"}` : `${shown} ${noun}`;
    }
    // Maps are built lazily; let any newly shown cards frame themselves.
    window.dispatchEvent(new Event("resize"));
  };

  document.querySelectorAll<HTMLElement>("[data-filter-group]").forEach((group) => {
    const name = group.dataset.filterGroup ?? "";
    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>("[data-filter-value]"));
    const choose = (button: HTMLButtonElement, focus = false) => {
      buttons.forEach((b) => {
        const chosen = b === button;
        b.setAttribute("aria-checked", String(chosen));
        b.tabIndex = chosen ? 0 : -1;
      });
      if (focus) button.focus();
      filters[name] = button.dataset.filterValue ?? "all";
      applyRouteFilters();
    };
    buttons.forEach((button, index) => {
      button.addEventListener("click", () => choose(button));
      button.addEventListener("keydown", (event) => {
        let next = -1;
        if (event.key === "ArrowRight" || event.key === "ArrowDown") next = (index + 1) % buttons.length;
        else if (event.key === "ArrowLeft" || event.key === "ArrowUp") next = (index - 1 + buttons.length) % buttons.length;
        else return;
        event.preventDefault();
        choose(buttons[next], true);
      });
    });
  });
</script>

