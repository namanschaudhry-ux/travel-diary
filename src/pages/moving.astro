<script>
  import L from "leaflet";
  import { decodePolyline } from "../lib/polyline";
  import { cityMapBounds, frameCityMap } from "../lib/city-map-frame";

  // Big city tiles: a still picture of the city's route map (no zoom, no
  // dragging), redrawn when the run / cycle / swim filter changes.
  const tileUrl = (theme: string | null) =>
    `https://services.arcgisonline.com/ArcGIS/rest/services/Canvas/${theme === "light" ? "World_Light_Gray_Base" : "World_Dark_Gray_Base"}/MapServer/tile/{z}/{y}/{x}`;
  const accent = getComputedStyle(document.documentElement).getPropertyValue("--color-accent").trim() || "#b08968";
  type Built = { map: L.Map; tiles: L.TileLayer; lines: L.LayerGroup; routes: Record<string, [number, number][][]>; target: HTMLElement };
  const built: Built[] = [];
  let sport = "run";


  function draw(b: Built) {
    b.lines.clearLayers();
    const routes = b.routes[sport] ?? [];
    const all = routes.flat();
    if (all.length < 2) return;
    routes.forEach((points) => {
      if (points.length > 1) L.polyline(points, { color: accent, weight: 2.5, opacity: 0.75, lineCap: "round", interactive: false }).addTo(b.lines);
    });
    const radiusKm = Number(sport === "swim" ? b.target.dataset.swimFrameRadius : sport === "run" ? b.target.dataset.frameRadius : 0);
    // Run maps with a fixed spot ("lat,lng,km", e.g. Melbourne's CBD) open on that instead.
    const [lat, lng, km] = (b.target.dataset.frameCenter ?? "").split(",").map(Number);
    let bounds = sport === "run" && b.target.dataset.frameCenter ? L.latLng(lat, lng).toBounds(km * 2000) : cityMapBounds(all, radiusKm);
    // data-frame-shift ("km east,km north") slides the run frame across without changing its size.
    if (sport === "run" && b.target.dataset.frameShift) {
      const [east, north] = b.target.dataset.frameShift.split(",").map(Number);
      const dLat = north / 110.57, dLng = east / (111.32 * Math.cos(bounds.getCenter().lat * Math.PI / 180));
      bounds = L.latLngBounds([bounds.getSouth() + dLat, bounds.getWest() + dLng], [bounds.getNorth() + dLat, bounds.getEast() + dLng]);
    }
    // data-frame-bounds sets an exact view for this sport, overriding the framing above.
    // frameCityMap leaves room around its bounds (they fill about half the tile's width);
    // an exact view should fill the tile instead, so it's set directly.
    const exact = (JSON.parse(b.target.dataset.frameBounds ?? "{}") as Record<string, [number, number, number, number]>)[sport];
    if (exact) {
      const view = L.latLngBounds([exact[0], exact[1]], [exact[2], exact[3]]);
      b.map.invalidateSize();
      b.map.setMinZoom(0);
      b.map.setMaxZoom(18);
      const zoom = b.map.getBoundsZoom(view, false);
      b.map.setView(view.getCenter(), zoom, { animate: false });
      b.map.setMinZoom(zoom);
      b.map.setMaxZoom(zoom);
      return;
    }
    frameCityMap(b.map, b.target, bounds);
  }

  document.querySelectorAll<HTMLElement>(".city-map").forEach((target) => {
    const map = L.map(target, {
      zoomControl: false, attributionControl: true, dragging: false, scrollWheelZoom: false, doubleClickZoom: false,
      touchZoom: false, boxZoom: false, keyboard: false, zoomSnap: 0,
    });
    const tiles = L.tileLayer(tileUrl(document.documentElement.getAttribute("data-theme")), { maxZoom: 16, attribution: "Tiles &copy; Esri" }).addTo(map);
    const encoded: Record<string, string[]> = JSON.parse(target.dataset.routes ?? "{}");
    const routes = Object.fromEntries(Object.entries(encoded).map(([key, lines]) => [key, lines.map(decodePolyline)]));
    const b = { map, tiles, lines: L.layerGroup().addTo(map), routes, target };
    built.push(b);
    draw(b);
  });

  document.querySelectorAll<HTMLButtonElement>("[data-filter-btn]").forEach((btn) => {
    btn.addEventListener("click", () => {
      sport = btn.dataset.filterBtn ?? "run";
      requestAnimationFrame(() => built.forEach((b) => { if (!b.target.closest("[hidden]")) draw(b); }));
    });
  });

  new MutationObserver(() => {
    const url = tileUrl(document.documentElement.getAttribute("data-theme"));
    built.forEach((b) => b.tiles.setUrl(url));
  }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

  let resizeTimer: number | undefined;
  window.addEventListener("resize", () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => built.forEach(draw), 150);
  });
</script>

