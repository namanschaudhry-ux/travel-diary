  /* The watch face (case and bezel from the homepage Garmin, strap removed). The screen
     shows the three views as a Garmin-style menu, the current one inverted. */
  .view-watch { position: relative; width: 168px; aspect-ratio: 440 / 427; }
  .view-watch[data-city-only] .view-watch-item:not([data-view="city"]) { opacity: .18; }
  .view-watch[data-city-only] .view-watch-screen, .view-watch[data-city-only] .view-watch-button { cursor: default; }
  .view-watch-face { display: block; width: 100%; height: auto; filter: drop-shadow(0 6px 12px rgb(0 0 0 / 45%)); pointer-events: none; user-select: none; }
  .view-watch-screen { position: absolute; left: 30%; top: 46%; width: 44%; height: 23%; display: flex; flex-direction: column; justify-content: center; gap: 1px; padding: 0; border: 0; background: transparent; cursor: pointer; color: #d3d5d0; }
  .view-watch-item { display: block; padding: 1px 0; font: 700 11px / 1.15 "Arial Narrow", Arial, sans-serif; letter-spacing: .08em; text-transform: uppercase; text-align: center; opacity: .55; border-radius: 2px; }
  .view-watch-item[aria-current] { opacity: 1; background: #d3d5d0; color: #0d0e0d; }
  .view-watch-button { position: absolute; width: 9%; height: 13%; padding: 0; border: 0; background: transparent; cursor: pointer; border-radius: 6px; }
  .view-watch-up { left: -1%; top: 30%; }
  .view-watch-down { left: -1%; top: 57%; }
  .view-watch-back { right: -1%; top: 57%; }
  .view-watch-button:focus-visible, .view-watch-screen:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  /* Running turtle, the homepage artwork drawn in the theme's text colour. */
  .moving-turtle { display: block; flex: none; height: 46px; aspect-ratio: 610 / 270; background: var(--color-paper); opacity: .9;
    -webkit-mask: url('/images/turtle.png') center / contain no-repeat; mask: url('/images/turtle.png') center / contain no-repeat; }
  /* Globe flower, the homepage artwork, shown instead of the turtle on the cycle filter. */
  .moving-flower { display: block; flex: none; height: 46px; width: auto; aspect-ratio: 1; color: var(--color-paper); opacity: .9; }
  .moving-turtle[hidden], .moving-flower[hidden] { display: none; }
  /* The total, handwritten like Naman's own note ("7000 km / 35 runs"): two short lines,
     the km above the run count, in Waiting for the Sunrise. */
  .total-km { margin: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 0; font: 400 32px / .95 "Waiting for the Sunrise", "Caveat", cursive; letter-spacing: .02em; white-space: nowrap; text-shadow: 0 1px 2px rgb(0 0 0 / 35%); }
  .total-line { display: block; }
  .total-line + .total-line { margin-top: 2px; font-size: 26px; padding-left: .5em; }
</style>

<style>
  .city-display-name { display: block; font-family: "Bagel Fat One", sans-serif; font-size: clamp(28px, 4vw, 44px); font-weight: 400; line-height: 1.1; letter-spacing: -.025em; text-transform: none; text-wrap: balance; }
  .city-display-country { display: block; font-family: "Bagel Fat One", sans-serif; font-size: 16px; font-weight: 400; line-height: 1.3; letter-spacing: .015em; margin-top: 4px; }
  /* Name small and top left, numbers bottom left, with no dark wash or glow behind them. */
  .city-map-card .city-map-caption--top { padding: 18px 22px; text-align: left; background: none; text-shadow: none; }
  .city-map-card .city-map-caption--bottom { padding: 18px 22px; background: none; text-shadow: none; }
  .city-map-caption--top .city-display-country { color: rgb(255 255 255 / 80%); }
  .city-card:not(.city-map-card) .city-display-name { font-size: clamp(26px, 3vw, 34px); }
</style>

<style>
  /* City names in the spirit of the Moving page's NAMAN wordmark: a wide, high-contrast
     serif in capitals over fine horizontal rules, with a hairline orbit swept round it. */
  .city-wordmark { position: relative; display: inline-block; padding: 3px 9px; font-family: "Bodoni Moda", "Bodoni 72", Didot, serif; font-variation-settings: "opsz" 96; font-size: 17px; font-weight: 600; line-height: 1; letter-spacing: .07em; text-transform: uppercase; color: #fff; white-space: nowrap; }
  .city-wordmark::before { content: ""; position: absolute; inset: -6px -14px; z-index: -1; background: repeating-linear-gradient(to bottom, rgb(255 255 255 / 30%) 0 1px, transparent 1px 7px);
    -webkit-mask: radial-gradient(closest-side, #000 55%, transparent); mask: radial-gradient(closest-side, #000 55%, transparent); }
  .city-wordmark::after { content: ""; position: absolute; inset: -6px -11px; border-radius: 50%; border: 1px solid transparent; border-top-color: rgb(255 255 255 / 85%); border-bottom-color: rgb(255 255 255 / 85%); transform: rotate(-5deg);
    -webkit-mask: linear-gradient(100deg, #000 0 30%, transparent 45% 55%, #000 70%); mask: linear-gradient(100deg, #000 0 30%, transparent 45% 55%, #000 70%); pointer-events: none; }
  .city-outline { width: min(100%, 400px); margin-inline: auto; }
  .city-outline :global(svg) { display: block; width: 100%; height: 66px; overflow: visible; }
  .city-card:not(.city-map-card) .city-outline :global(svg) { height: 46px; }
</style>

<style>
  .country-outline :global(svg) { display: block; width: auto; max-width: 160px; height: 26px; margin-inline: auto; }
</style>
