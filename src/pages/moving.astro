---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { cityActivity, activityTotals as totals } from "../data/activity-summary";
import { runLifetime } from "../data/run-lifetime";
import "leaflet/dist/leaflet.css";
import { cityRoutes, cityRideRoutes, citySwimRoutes, citySlug, tileCities, cityTileLines, tileFrameRadiusKm, cityFrameCenter, tileFrameShiftKm, tileFrameBounds, cityActivityCount, cityRunKm } from "../data/city-routes";
import { cityDays } from "../data/city-days";
import RouteGrid from "../components/RouteGrid.astro";
import novablast5WinterSea from "../assets/shoes/novablast-5-winter-sea.png";
import novablast5PurpleRed from "../assets/shoes/novablast-5-purple-red.png";
import zoomFly6Kipchoge from "../assets/shoes/zoom-fly-6-kipchoge.png";
import nimbus22RedBlack from "../assets/shoes/nimbus-22-red-black.png";
import nb1080NycMarathon from "../assets/shoes/nb-1080v14-nyc-marathon.png";
import nimbusPlatinum from "../assets/shoes/nimbus-25-platinum.png";
import nimbusGreyBlue from "../assets/shoes/nimbus-25-grey-blue.png";
import nimbusLite3AzureAmber from "../assets/shoes/nimbus-lite-3-azure-amber.png";
import novablastOrange from "../assets/shoes/novablast-4-orange.png";
import novablastParis from "../assets/shoes/novablast-4-paris.png";
import tarmacSl7 from "../assets/bike/tarmac-sl7-sport-black.png";

// Newest first by year; the order within a year is Naman's choice and matches the Gear library.
const shoes = [
  { image: zoomFly6Kipchoge, alt: "Nike Zoom Fly 6, Eliud Kipchoge 'No Human Is Limited' edition.", label: "Zoom Fly 6", sub: "Eliud Kipchoge", year: "2025" },
  { image: novablast5PurpleRed, alt: "ASICS Novablast 5, Tokyo edition.", label: "Novablast 5", sub: "Tokyo", year: "2025" },
  { image: novablast5WinterSea, alt: "ASICS Novablast 5 in the Winter Sea/Stillwater colorway.", label: "Novablast 5", sub: "Winter Sea", year: "2025" },
  { image: nb1080NycMarathon, alt: "New Balance Fresh Foam X 1080 v14, TCS New York City Marathon edition, white with hi-pink and black.", label: "Fresh Foam X 1080 v14", sub: "NYC Marathon 2024", year: "2024" },
  { image: novablastOrange, alt: "ASICS Novablast 4 in the Bright Sunstone orange colorway.", label: "Novablast 4", sub: "Bright Sunstone", year: "2024" },
  { image: novablastParis, alt: "ASICS Novablast 4 in the Paris Olympics Cool Matcha/Safety Yellow colorway.", label: "Novablast 4", sub: "Paris", year: "2024" },
  { image: nimbusGreyBlue, alt: "ASICS GEL-Nimbus 25 in the Sheet Rock/Indigo Blue colorway.", label: "GEL-Nimbus 25", sub: "Sheet Rock Indigo", year: "2023" },
  { image: nimbusPlatinum, alt: "ASICS GEL-Nimbus 25 in the Platinum Black/Pure Silver colorway.", label: "GEL-Nimbus 25", sub: "Platinum", year: "2023" },
  { image: nimbusLite3AzureAmber, alt: "ASICS GEL-Nimbus Lite 3 in the Azure/Amber colorway.", label: "GEL-Nimbus Lite 3", sub: "Azure / Amber", year: "2023" },
  { image: nimbus22RedBlack, alt: "ASICS GEL-Nimbus 22 in black with a Classic Red midsole.", label: "GEL-Nimbus 22", sub: "Red / Black", year: "2022" },
];

const cities = [...cityActivity]
  .map((c) => ({ ...c, total: c.run + c.cycle + c.swim }))
  .sort((a, b) => b.total - a.total);
// Cities with a full route map get a big map tile at the top of the city view;
// the rest stay as small cards below.
// Alpine Shire's tile is shown as Bright (where the runs are) and comes last, after Naxos.
const lastTiles = ["Alpine Shire"];
const mapCities = cities
  .filter((c) => tileCities.has(c.city) && cityRoutes[c.city]?.length)
  .sort((a, b) => Number(lastTiles.includes(a.city)) - Number(lastTiles.includes(b.city)));
const tileName = (city: string) => (city === "Alpine Shire" ? "Bright" : city);

// Every route from every city, newest first, for the "routes" view.
const allRoutes = Object.entries(cityRoutes)
  .flatMap(([city, routes]) => routes.map((route) => ({ ...route, city })))
  .sort((a, b) => b.date.localeCompare(a.date));
// Cities in the routes view's city filter, most routes first (Alpine Shire shown as Bright).
const routeCities = Object.entries(allRoutes.reduce<Record<string, number>>((n, r) => ({ ...n, [r.city]: (n[r.city] ?? 0) + 1 }), {}))
  .sort((a, b) => b[1] - a[1])
  .map(([city]) => city);
const allRides = Object.entries(cityRideRoutes)
  .flatMap(([city, routes]) => routes.map((route) => ({ ...route, city })))
  .sort((a, b) => b.date.localeCompare(a.date));

// Map pages per city and sport. A city card links to the page for the sport
// that is selected, and is a plain card when that sport has no routes there.
const routeLinks = (city: string) => ({
  run: cityRoutes[city]?.length ? { href: `/moving/${citySlug(city)}/`, count: cityRoutes[city].length } : null,
  cycle: cityRideRoutes[city]?.length ? { href: `/moving/${citySlug(city)}/cycle/`, count: cityRideRoutes[city].length } : null,
  swim: citySwimRoutes[city]?.length ? { href: `/moving/${citySlug(city)}/swim/`, count: citySwimRoutes[city].length } : null,
});

const fmt = (n: number) => n.toLocaleString("en-US", { maximumFractionDigits: 1 });

// A city shows under a sport if it has 10 km or more of it, or any mapped routes for it.
const hasRoutes = (city: string, sport: string) =>
  ((sport === "run" ? cityRoutes : sport === "cycle" ? cityRideRoutes : citySwimRoutes)[city]?.length ?? 0) > 0;
// Map tiles show all-time run km (every GPS run the site holds, as on the city page);
// everything else is from the 2023-on summary.
const typeRows = (c: (typeof cities)[number]) =>
  [
    { label: "run", value: tileCities.has(c.city) ? Math.round(cityRunKm(c.city)) : c.run },
    { label: "cycle", value: c.cycle },
    { label: "swim", value: c.swim },
  ].filter((row) => row.value >= 10 || hasRoutes(c.city, row.label));

const cityLettering = import.meta.glob<string>("../assets/city-lettering/*.svg", { eager: true, query: "?raw", import: "default" });
const cityOutline = (name: string) => cityLettering[`../assets/city-lettering/${name.toLowerCase().replaceAll(" ", "-")}.svg`];
const filters = ["run", "cycle", "swim"];
---

<Layout title="On the move — Naman Chaudhry" description="Kilometres logged by city, pulled from Strava.">
  {/* Handwriting for the top bar total; loaded here because the stylesheet @import of Google Fonts is dropped by Tailwind. */}
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Waiting+for+the+Sunrise&display=swap" />
  {/* Sport filters on the left; on the right the hover bar and the running turtle (from the homepage artwork row). */}
  <section class="sport-bar mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 pt-8 pb-8 sm:px-10 sm:pt-10">
    <div class="flex gap-2">
    {
      filters.map((f) => (
        <button
          type="button"
          data-filter-btn={f}
          aria-label={f === "run" ? "Run" : f === "cycle" ? "Cycle" : "Swim"}
          title={f === "run" ? "Run" : f === "cycle" ? "Cycle" : "Swim"}
          aria-pressed={f === "run" ? "true" : "false"}
          class:list={[
            "rounded-[8px] border px-4 py-1.5 font-sans text-xs uppercase tracking-[0.15em] transition-colors",
            f === "run"
              ? "border-accent text-accent"
              : "border-[var(--color-card-border)] text-[var(--color-muted-60)] hover:border-[var(--color-muted-40)] hover:text-paper",
          ]}
        >
          <svg width={f === "swim" ? 30 : 34} height={f === "swim" ? 30 : 34} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            {/* Running: a winged shoe (Hermes-style, after the Nike running badges on the mood
                board), the wings sweeping back from the bottom of the heel. */}
            {f === "run" && <>
              <path d="M10.6 21V15.4q0-1.2 1.1-1.4l2.1-.3 1.4 1.1 2.2-3.5h1.6l5.6 4.6q3.4 1.2 4.4 2.6.6.9.3 2.5z" />
              <path d="M10.6 22.8h17q2.3 0 2.7-1.7" />
              <path d="M18.4 13.2l1.4 1.3M17.4 14.8l1.5 1.2M13.2 19.1q6.2.7 11.4-1.9" />
              <path d="M10.5 21.5C7.5 21.3 4.6 22.4 2.2 24.8c2.6.3 5.3-.4 7.6-2.1" />
              <path d="M10.6 22.4c-2.4.9-4.4 2.6-5.6 5 2.4-.4 4.5-1.6 6-3.5" />
              <path d="M10.5 19.6c-2.4-.9-5-.9-7.4.1 1.9 1 4.2 1.3 6.4.7" />
            </>}
            {/* Cycling: an outline drivetrain, as in the gear-set drawing on the mood board: a toothed
                chainring with its crank and pedal, the chain, and a small rear cassette. */}
            {f === "cycle" && <>
              <circle cx="20.5" cy="18" r="7" />
              <circle cx="20.5" cy="18" r="8.6" stroke-width="1.6" stroke-dasharray="1.15 1.2" />
              <circle cx="20.5" cy="18" r="1.6" />
              <path d="M20.5 18l6.2-7.4M25.2 10.2h3" />
              <circle cx="5.5" cy="18" r="3" />
              <circle cx="5.5" cy="18" r="4.3" stroke-width="1.4" stroke-dasharray=".9 1" />
              <path d="M5.5 13.7l15-4.3M5.5 22.3l15 4.3" stroke-dasharray="1.3 1" />
            </>}
            {/* Swimming: racing goggles in three-quarter view, after the FORZA goggles on the
                mood board: two lenses with their rims, the nose bridge and the strap behind. */}
            {f === "swim" && <>
              <path d="M15.2 17.6c-.2-2.6 2.4-4.7 6-4.9 3.8-.2 7 1.4 7.2 3.8.2 2.6-2.5 4.7-6.1 4.9-3.8.2-6.9-1.3-7.1-3.8z" />
              <path d="M17.6 17.4c0-1.5 1.7-2.7 3.9-2.8 2.4-.1 4.4.8 4.5 2.3.1 1.6-1.6 2.8-3.9 2.9-2.4.1-4.4-.9-4.5-2.4z" stroke-width="1.2" />
              <path d="M3.3 15.9c0-1.9 1.6-3.3 3.6-3.3 2.2 0 4 1.4 4 3.3s-1.7 3.4-3.8 3.4c-2.1 0-3.8-1.5-3.8-3.4z" />
              <path d="M11 15.4q2.3-.9 4.4.7" />
              <path d="M28.3 15.6c1.6-.9 2.4-2.4 1.8-3.6-.7-1.5-3.3-2.1-6.9-2.1H8.9c-2.7 0-4.6.8-5.3 2" />
              <path d="M19 15.6l1.4-.6" stroke-width="1.2" />
            </>}
          </svg>
        </button>
      ))
    }
    </div>
    {/* The view switcher: the homepage Garmin's face (no strap) as a menu of City, Gear and
        Routes. Its side buttons step up and down the list; tapping the screen steps on. */}
    <div class="view-watch" id="view-toggle-wrap" role="group" aria-label="City, gear or routes view">
      <img class="view-watch-face" src="/images/instinct-face.png" alt="" width="440" height="427" />
      <button type="button" class="view-watch-screen" aria-label="Next view">
        {["city", "gear", "routes"].map((label) => (
          <span class="view-watch-item" data-view={label} aria-current={label === "city" ? "true" : undefined}>{label}</span>
        ))}
      </button>
      <button type="button" class="view-watch-button view-watch-up" data-step="-1" aria-label="Previous view" title="Previous view"></button>
      <button type="button" class="view-watch-button view-watch-down" data-step="1" aria-label="Next view" title="Next view"></button>
      <button type="button" class="view-watch-button view-watch-back" data-step="1" aria-label="Next view" title="Next view"></button>
    </div>
    {/* The hover bar (a city's share of the total, painted purple to pink) sits just left of the turtle. */}
    <div class="sport-meter flex items-center gap-4">
        <div
          id="top-strip"
          class="relative isolate flex overflow-hidden rounded-[10px] border border-[var(--color-card-border)]"
        >
          <div id="city-fill" aria-hidden="true"></div>
          {
            [
              { label: "run", value: runLifetime.km, count: runLifetime.runs, noun: "runs" },
              { label: "cycle", value: totals.cycle },
              { label: "swim", value: totals.swim },
            ].map((t) => (
              <div class="relative flex flex-1 items-center justify-center" data-total={t.value} data-sport={t.label} hidden={t.label !== "run"}>
                {/* The selected sport's total, over the hover paint, handwritten (the font closest to
                    Naman's own hand). Runs are all-time and add the run count on a second line. */}
                <p class="total-km text-paper" aria-label={`${fmt(Math.round(t.value))} km${t.count ? `, ${fmt(t.count)} ${t.noun}` : ""}`}>
                  <span class="total-line">{fmt(Math.round(t.value))} km</span>
                  {t.count ? <span class="total-line">{fmt(t.count)} {t.noun}</span> : null}
                </p>
              </div>
            ))
          }
        </div>
      <span class="moving-turtle" data-art-sports="run swim" aria-hidden="true"></span>
      {/* On the cycle filter the turtle swaps for the homepage's globe flower (third artwork from the left). */}
      <svg class="moving-flower" data-art-sports="cycle" hidden viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true">
        <g stroke-width="7"><ellipse cx="50" cy="19" rx="6" ry="9" transform="rotate(0 50 50)"/><ellipse cx="50" cy="19" rx="6" ry="9" transform="rotate(45 50 50)"/><ellipse cx="50" cy="19" rx="6" ry="9" transform="rotate(90 50 50)"/><ellipse cx="50" cy="19" rx="6" ry="9" transform="rotate(135 50 50)"/><ellipse cx="50" cy="19" rx="6" ry="9" transform="rotate(180 50 50)"/><ellipse cx="50" cy="19" rx="6" ry="9" transform="rotate(225 50 50)"/><ellipse cx="50" cy="19" rx="6" ry="9" transform="rotate(270 50 50)"/><ellipse cx="50" cy="19" rx="6" ry="9" transform="rotate(315 50 50)"/></g>
        <circle cx="50" cy="50" r="17" stroke-width="6"/>
        <g stroke-width="2"><ellipse cx="50" cy="50" rx="5.5" ry="13"/><path d="M50 37v26M38.5 44h23M37 50h26M38.5 56h23"/></g>
      </svg>
    </div>
  </section>


  <section class="mx-auto max-w-6xl px-6 pb-16 sm:px-10" data-view-section="city">
    <div class="city-map-grid">
      {mapCities.map((c) => {
        const links = routeLinks(c.city);
        // Encoded polylines per sport; the script below decodes them.
        const tileLines = cityTileLines(c.city);
        return (
          <a
            class="city-card city-map-card"
            data-city-card
            href={links.run?.href}
            data-run-href={links.run?.href}
            data-cycle-href={links.cycle?.href}
            data-swim-href={links.swim?.href}
            data-sports={typeRows(c).map((r) => r.label).join(" ")}
            hidden={!typeRows(c).some((r) => r.label === "run")}
            aria-label={`${tileName(c.city)} routes map`}
          >
            <div class="city-map" data-routes={JSON.stringify(tileLines)} data-frame-radius={tileFrameRadiusKm[c.city]} data-frame-center={cityFrameCenter[c.city] ? `${cityFrameCenter[c.city].center.join(",")},${cityFrameCenter[c.city].radiusKm}` : undefined} data-frame-shift={tileFrameShiftKm[c.city]?.join(",")} data-frame-bounds={tileFrameBounds[c.city] ? JSON.stringify(tileFrameBounds[c.city]) : undefined} data-swim-frame-radius="2" aria-hidden="true"></div>
            {/* Always shown: the city name (in the style of the Moving page's NAMAN wordmark) at the
                top, and the kilometres with the number of runs (or rides, swims) bottom left.
                Hover adds only "view map" and the corner marks. */}
            <span class="city-map-caption city-map-caption--top"><span class="city-wordmark">{tileName(c.city)}</span></span>
            <span class="city-map-caption city-map-caption--bottom">
              <span class="tile-stats">
                {typeRows(c).map((row) => (
                  <span class="tile-km" data-distance={row.value} data-sport={row.label} hidden={row.label !== "run"}>{fmt(row.value)} km</span>
                ))}
                {(["run", "cycle", "swim"] as const).map((sport) => {
                  const count = cityActivityCount(c.city, sport);
                  const noun = sport === "run" ? "run" : sport === "cycle" ? "ride" : "swim";
                  return count > 0 ? <span class="tile-count" data-route-hint={sport} hidden={sport !== "run"}>{fmt(count)} {count === 1 ? noun : `${noun}s`}</span> : null;
                })}
              </span>
              <span class="tile-view-map">view map →</span>
            </span>
            <span class="viewfinder-corner viewfinder-corner--tl" aria-hidden="true"></span>
            <span class="viewfinder-corner viewfinder-corner--tr" aria-hidden="true"></span>
            <span class="viewfinder-corner viewfinder-corner--bl" aria-hidden="true"></span>
            <span class="viewfinder-corner viewfinder-corner--br" aria-hidden="true"></span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-16 sm:px-10" data-view-section="routes" data-sport-section="run" hidden>
    {/* Three filters that combine: distance, all routes or races only, and city. Each
        works like the language toggle: click, or focus the row and use the arrow keys. */}
    <div class="route-filter" role="radiogroup" aria-label="Filter routes by distance" data-filter-group="distance">
      <button type="button" role="radio" aria-checked="true" tabindex="0" data-filter-value="all">all</button>
      <button type="button" role="radio" aria-checked="false" tabindex="-1" data-filter-value="marathon">marathons</button>
      <button type="button" role="radio" aria-checked="false" tabindex="-1" data-filter-value="30">30k+</button>
      <button type="button" role="radio" aria-checked="false" tabindex="-1" data-filter-value="25">25k+</button>
      <button type="button" role="radio" aria-checked="false" tabindex="-1" data-filter-value="20">20k+</button>
    </div>
    <div class="route-filter" role="radiogroup" aria-label="Show all routes or races only" data-filter-group="type">
      <button type="button" role="radio" aria-checked="true" tabindex="0" data-filter-value="all">all</button>
      <button type="button" role="radio" aria-checked="false" tabindex="-1" data-filter-value="races">races</button>
    </div>
    <div class="route-filter" role="radiogroup" aria-label="Filter routes by city" data-filter-group="city">
      <button type="button" role="radio" aria-checked="true" tabindex="0" data-filter-value="all">all</button>
      {routeCities.map((city) => (
        <button type="button" role="radio" aria-checked="false" tabindex="-1" data-filter-value={city}>{tileName(city).toLowerCase()}</button>
      ))}
    </div>
    <p id="route-count" class="mb-6 text-center font-sans text-[11px] uppercase tracking-[0.15em] text-[var(--color-muted-40)]">
      {allRoutes.length} routes
    </p>
    <RouteGrid routes={allRoutes} showCity />
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-16 sm:px-10" data-view-section="routes" data-sport-section="cycle" hidden>
    <p class="mb-6 text-center font-sans text-[11px] uppercase tracking-[0.15em] text-[var(--color-muted-40)]">
      {allRides.length} routes
    </p>
    <RouteGrid routes={allRides} showCity />
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-16 sm:px-10" data-view-section="gear" data-sport-section="run" hidden>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        shoes.map((shoe) => (
          <div
            class="city-card rounded-[12px] border border-[var(--color-card-border)] p-6 text-center"
            data-gear-card
            tabindex="0"
            data-distance={totals.run / shoes.length}
          >
            <figcaption class="shoe-caption mb-2 font-sans text-sm font-light text-paper/90">
              <span class="block">{shoe.label}</span>
              <span class="block">{shoe.sub}</span>
            </figcaption>
            <Image src={shoe.image} alt={shoe.alt} widths={[240, 360, 480]} sizes="(min-width: 640px) 280px, 55vw" format="webp" class="mx-auto aspect-[15/8] w-full max-w-[280px] object-contain object-bottom" />
            <p class="shoe-caption mt-2 font-sans text-sm font-light text-paper/90">{shoe.year}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-16 sm:px-10" data-view-section="gear" data-sport-section="cycle" hidden>
    <div
      class="city-card mx-auto max-w-sm rounded-[12px] border border-[var(--color-card-border)] p-6 text-center"
      data-gear-card
      tabindex="0"
      data-distance={totals.cycle}
    >
      <Image src={tarmacSl7} alt="Specialized Tarmac SL7 Sport road bike in black." widths={[240, 360, 480]} sizes="(min-width: 640px) 280px, 60vw" format="webp" class="mx-auto h-auto w-full max-w-[280px]" />
      <div class="mt-3 flex flex-col gap-0.5">
        <span class="city-name font-sans text-xs font-semibold uppercase tracking-[0.12em] text-accent">Specialized Tarmac SL7</span>
        <span class="font-sans text-xs text-[var(--color-muted-40)]">Sport, Black</span>
      </div>
    </div>
  </section>
</Layout>

<script>
  const ACTIVE =
    "rounded-[8px] border px-4 py-1.5 font-sans text-xs uppercase tracking-[0.15em] transition-colors border-accent text-accent";
  const INACTIVE =
    "rounded-[8px] border px-4 py-1.5 font-sans text-xs uppercase tracking-[0.15em] transition-colors border-[var(--color-card-border)] text-[var(--color-muted-60)] hover:border-[var(--color-muted-40)] hover:text-paper";

  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter-btn]");
  const cityCards = document.querySelectorAll<HTMLElement>("[data-city-card]");
  const viewToggleWrap = document.getElementById("view-toggle-wrap");

  const fill = document.querySelector<HTMLElement>("#city-fill");
  let selectedSport = "run";
  let selectedView = "city";
  let hoveredCard: HTMLElement | null = null;
  let focusedCard: HTMLElement | null = null;

  function cardDistance(card: HTMLElement): number {
    if (card.hasAttribute("data-gear-card")) return Number(card.dataset.distance ?? 0);
    return Number(card.querySelector<HTMLElement>(`[data-sport="${selectedSport}"]`)?.dataset.distance ?? 0);
  }

  function updateFill() {
    const card = hoveredCard ?? focusedCard;
    const distance = card ? cardDistance(card) : 0;
    const total = Number(document.querySelector<HTMLElement>(`#top-strip [data-sport="${selectedSport}"]`)?.dataset.total ?? 0);
    const share = total > 0 ? Math.min(1, Math.max(0, distance / total)) : 0;
    fill?.style.setProperty("--city-share", String(share));
  }

  function trackDistanceCard(card: HTMLElement) {
    card.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "touch") return;
      hoveredCard = card;
      updateFill();
    });
    card.addEventListener("pointerleave", () => {
      if (hoveredCard === card) hoveredCard = null;
      updateFill();
    });
    card.addEventListener("focus", () => { focusedCard = card; updateFill(); });
    card.addEventListener("blur", () => { focusedCard = null; updateFill(); });
  }

  cityCards.forEach(trackDistanceCard);
  document.querySelectorAll<HTMLElement>("[data-gear-card]").forEach(trackDistanceCard);

  function updateVisibility() {
    document.querySelectorAll<HTMLElement>("[data-view-section]").forEach((el) => {
      const sportMatches = !el.dataset.sportSection || el.dataset.sportSection === selectedSport;
      el.hidden = el.dataset.viewSection !== selectedView || !sportMatches;
    });
    // Swim has only the city view: the watch stays, with Gear and Routes greyed out.
    if (viewToggleWrap) viewToggleWrap.toggleAttribute("data-city-only", selectedSport === "swim");
  }

  function applyFilter(filter: string) {
    selectedSport = filter;
    // The hover paint follows the sport: purple to pink for runs, light to dark blue for rides.
    if (fill) fill.dataset.paint = filter;
    hoveredCard = null;
    focusedCard = null;
    if (filter === "swim") selectedView = "city";
    updateFill();
    buttons.forEach((btn) => {
      const isActive = btn.dataset.filterBtn === filter;
      btn.className = isActive ? ACTIVE : INACTIVE;
      btn.setAttribute("aria-pressed", String(isActive));
    });

    document.querySelectorAll<HTMLElement>("#top-strip [data-sport]").forEach((el) => {
      el.hidden = el.dataset.sport !== filter;
    });
    // Turtle for run and swim, globe flower for cycle.
    document.querySelectorAll<SVGElement | HTMLElement>("[data-art-sports]").forEach((el) => {
      if (el.dataset.artSports?.split(" ").includes(filter)) el.removeAttribute("hidden");
      else el.setAttribute("hidden", "");
    });

    cityCards.forEach((card) => {
      const sports = (card.dataset.sports ?? "").split(" ");
      card.hidden = !sports.includes(filter);
      card.querySelectorAll<HTMLElement>("[data-sport]").forEach((el) => {
        el.hidden = el.dataset.sport !== filter;
      });
      card.querySelectorAll<HTMLElement>("[data-route-hint]").forEach((el) => {
        el.hidden = el.dataset.routeHint !== filter;
      });
      // Link to this sport's map page, or behave as a plain card if it has none.
      if (card instanceof HTMLAnchorElement) {
        const href = card.dataset[`${filter}Href`];
        if (href) {
          card.href = href;
          card.removeAttribute("tabindex");
        } else {
          card.removeAttribute("href");
          card.tabIndex = 0;
        }
      }
    });

    if (filter === "swim") resetViewToCity();
    updateVisibility();
  }

  let resetViewToCity: () => void = () => {};

  buttons.forEach((btn, index) => {
    btn.addEventListener("click", () => applyFilter(btn.dataset.filterBtn ?? "run"));
    btn.addEventListener("keydown", (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey || !["ArrowLeft", "ArrowRight"].includes(event.key)) return;
      event.preventDefault();
      const direction = event.key === "ArrowRight" ? 1 : -1;
      const next = buttons[(index + direction + buttons.length) % buttons.length];
      // Use the click path so every sport-dependent map and view updates too.
      next.focus({ preventScroll: true });
      next.click();
    });
  });

  // The watch on the top row picks the view: up / down buttons and the screen step
  // through City, Gear and Routes, wrapping round.
  const viewOrder = ["city", "gear", "routes"];
  const watchItems = Array.from(document.querySelectorAll<HTMLElement>(".view-watch-item"));
  let setView: (view: string) => void = (view: string) => {
    selectedView = view;
    watchItems.forEach((item) => item.toggleAttribute("aria-current", item.dataset.view === view));
    updateVisibility();
  };
  resetViewToCity = () => setView("city");
  const stepView = (step: number) => {
    if (selectedSport === "swim") return;
    const index = viewOrder.indexOf(selectedView);
    setView(viewOrder[(index + step + viewOrder.length) % viewOrder.length]);
  };
  document.querySelector(".view-watch-screen")?.addEventListener("click", () => stepView(1));
  document.querySelectorAll<HTMLButtonElement>(".view-watch-button").forEach((button) => {
    button.addEventListener("click", () => stepView(Number(button.dataset.step ?? 1)));
  });
  // Arrow keys from anywhere on the page: up / down step through City, Gear and Routes
  // (swim has only the city view), left / right through the sports. Left alone in the
  // route filters and text fields, where the arrows already do something.
  document.addEventListener("keydown", (event) => {
    if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
    if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(event.key)) return;
    const target = event.target;
    if (target instanceof Element && target.closest("input, textarea, select, [contenteditable], [role='radiogroup']")) return;
    event.preventDefault();
    // Left / right: the sport (run, cycle, swim), the same as the sport buttons' own arrow keys.
    if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
      const sportButtons = Array.from(buttons);
      const index = sportButtons.findIndex((btn) => btn.dataset.filterBtn === selectedSport);
      const step = event.key === "ArrowRight" ? 1 : -1;
      sportButtons[(index + step + sportButtons.length) % sportButtons.length]?.click();
      return;
    }
    // Up / down: the view on the watch (City, Gear, Routes), like its up and down buttons.
    stepView(event.key === "ArrowDown" ? 1 : -1);
  });

  updateVisibility();
</script>

