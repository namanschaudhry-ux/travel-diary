---
// DRAFT photos homepage: one tile per trip page, newest first.
// Titles use a tight, heavy grotesk (Inter Tight) to echo the Verci post type.
// Tiles reuse the gallery card motion (lift + slight scale) and add a dark
// overlay that clears on hover/focus, plus a soft glow in each trip's accent.
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { japanPhotos } from "../../data/japan-photos";
import melbourneCover from "../../assets/photos/melbourne-2026/IMG_9247.jpeg";
import nycCover from "../../assets/photos/new-york/brooklyn-bridge.jpg";
import nzWinterCover from "../../assets/photos/featured/lake-dusk.jpg";
import nzAutumnCover from "../../assets/photos/new-zealand-autumn-2026/IMG_6280.jpeg";

const japanFiles = import.meta.glob<{ default: ImageMetadata }>("/src/assets/photos/japan-2025/*.jpg", { eager: true });
const japanCover = japanFiles[`/src/assets/photos/japan-2025/${japanPhotos[0].id}.jpg`]?.default;

import melbourneAutumnCover from "../../assets/photos/melbourne-autumn-2026/IMG_7508.jpeg";
import sanFranciscoCover from "../../assets/photos/san-francisco-2026/IMG_9083.jpeg";

const trips = [
  { href: "/photos/melbourne/", place: "Melbourne", season: "Spring ’26", image: melbourneCover, alt: "Melbourne skyline across the bay at sunset.", accent: "#c5e063", title: "#8eaf62", focus: "50% 80%" },
  { href: "/photos/san-francisco/", place: "San Francisco", season: "Summer ’26", image: sanFranciscoCover, alt: "A corner bookshop in San Francisco.", accent: "#ffd60a", title: "#b9ac48" },
  { href: "/photos/new-york/", place: "New York", season: "Summer ’26", image: nycCover, alt: "Walkers on the Brooklyn Bridge promenade toward its stone tower.", accent: "#ffd60a", title: "#b9ac48" },
  { href: "/photos/new-zealand/", place: "New Zealand", season: "Winter ’26", image: nzWinterCover, alt: "A lakeside beach and snow-capped mountains at dusk.", accent: "#8fd4ff", title: "#78a0c2" },
  { href: "/photos/melbourne-autumn/", place: "Melbourne", season: "Autumn ’26", image: melbourneAutumnCover, alt: "Melbourne skyline at sunset.", accent: "#f4a259", title: "#af7e45" },
  { href: "/photos/new-zealand-autumn/", place: "New Zealand", season: "Autumn ’26", image: nzAutumnCover, alt: "A panorama of jagged peaks from a stony ridge in Arthur's Pass.", accent: "#f4a259", title: "#af7e45" },
  { href: "/photos/japan/", place: "Japan", season: "Winter ’25", image: japanCover, alt: japanPhotos[0].alt, accent: "#8fd4ff", title: "#78a0c2" },
].filter((trip) => trip.image);
---

<Layout title="Photos — Naman" description="Photo diaries from every trip.">
  <section class="mx-auto max-w-6xl px-6 pt-10 pb-24 sm:px-10">
    <header class="photos-header">
      <h1 class="photos-title">photos</h1>
      <p class="photos-count">{trips.length} trips</p>
    </header>

    <ul class="trip-grid" role="list">
      {trips.map((trip, index) => (
        <li class="trip-item">
          <a href={trip.href} class="trip-tile" style={`--tile-accent: ${trip.accent}; --tile-title: ${trip.title}; --tile-focus: ${trip.focus ?? "50% 50%"};`} aria-label={`${trip.place}, ${trip.season}`}>
            <Image
              src={trip.image!}
              alt={trip.alt}
              widths={[800, 1200, 1600, 2000]}
              sizes="(min-width: 1152px) 720px, (min-width: 640px) 66vw, 130vw"
              format="webp"
              quality={88}
              loading={index < 3 ? "eager" : "lazy"}
              class="trip-image"
            />
            <span class="trip-shade" aria-hidden="true"></span>
            <span class="trip-text" aria-hidden="true">
              <span class="trip-place">{trip.place}</span>
              <span class="trip-season">{trip.season}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .photos-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 28px;
  }
  .photos-title {
    margin: 0;
    font-family: "Inter Tight", "Inter", sans-serif;
    font-weight: 800;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--color-paper);
  }
  .photos-count {
    margin: 0;
    font: 12px / 1.4 monospace;
    letter-spacing: 0.06em;
    color: var(--color-paper-dim);
  }

  .trip-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .trip-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  }

  .trip-tile {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 12px;
    background: var(--color-ink-soft, #1a1a1a);
    color: #fff;
    text-decoration: none;
    isolation: isolate;
    transition: transform 240ms ease, box-shadow 240ms ease;
  }
  .trip-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--tile-focus);
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1), filter 240ms ease;
  }
  /* Dark overlay until hover or focus. */
  .trip-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 88%), rgb(0 0 0 / 68%) 55%, rgb(0 0 0 / 62%));
    transition: opacity 280ms ease;
  }
  .trip-text {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 22px 24px;
    z-index: 1;
  }
  .trip-place {
    font-family: "Inter Tight", "Inter", sans-serif;
    font-weight: 800;
    font-size: clamp(22px, 2.8vw, 32px);
    line-height: 0.95;
    letter-spacing: -0.045em;
    /* A slightly darker, cooler tone of the season colour (set per trip). */
    color: var(--tile-title);
    text-shadow: 0 2px 18px rgb(0 0 0 / 35%);
  }
  .trip-season {
    font-family: "Inter Tight", "Inter", sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--tile-accent);
  }

  /* Hover / keyboard focus: lift and expand like the gallery cards, clear the
     overlay, and add a light glow in the trip's accent. */
  @media (hover: hover) and (pointer: fine) {
    .trip-tile:hover {
      transform: translateY(-8px) scale(1.025);
      box-shadow: 0 0 0 1px color-mix(in srgb, var(--tile-accent) 55%, transparent), 0 18px 48px color-mix(in srgb, var(--tile-accent) 28%, transparent);
    }
    .trip-tile:hover .trip-shade { opacity: 0.2; }
    .trip-tile:hover .trip-image { transform: scale(1.04); filter: brightness(1.08) saturate(1.05); }
  }
  .trip-tile:focus-visible {
    outline: 2px solid var(--tile-accent);
    outline-offset: 4px;
    transform: translateY(-8px) scale(1.025);
    box-shadow: 0 18px 48px color-mix(in srgb, var(--tile-accent) 28%, transparent);
  }
  .trip-tile:focus-visible .trip-shade { opacity: 0.2; }

  /* Touch screens have no hover, so keep the overlay lighter. */
  @media (hover: none) {
    .trip-shade { opacity: 0.6; }
  }
  @media (prefers-reduced-motion: reduce) {
    .trip-tile, .trip-image, .trip-shade { transition: none; }
    .trip-tile:hover, .trip-tile:focus-visible { transform: none; }
    .trip-tile:hover .trip-image { transform: none; }
  }
</style>
