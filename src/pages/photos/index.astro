---
// Trip selector draft. Existing gallery destinations and cover images are preserved.
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { japanPhotos } from "../../data/japan-photos";
import melbourneCover from "../../assets/photos/melbourne-2026/IMG_9247.jpeg";
import nycCover from "../../assets/photos/new-york/brooklyn-bridge.jpg";
import nzWinterCover from "../../assets/photos/featured/lake-dusk.jpg";
import nzAutumnCover from "../../assets/photos/new-zealand-autumn-2026/IMG_6280.jpeg";

const japanFiles = import.meta.glob<{ default: ImageMetadata }>("/src/assets/photos/japan-2025/*.jpg", { eager: true });
const japanCover = japanFiles[`/src/assets/photos/japan-2025/${japanPhotos[0].id}.jpg`]?.default;

import melbourneAutumnCover from "../../assets/photos/melbourne-autumn-2026/IMG_7508.jpeg";
import sanFranciscoCover from "../../assets/photos/san-francisco-2026/IMG_9083.jpeg";

const trips = [
  { href: "/photos/melbourne/", code: "MEL S", place: "Melbourne", season: "Spring ’26", image: melbourneCover, alt: "Melbourne skyline across the bay at sunset.", accent: "#c5e063", title: "#8eaf62", focus: "50% 80%" },
  { href: "/photos/san-francisco/", code: "SF", place: "San Francisco", season: "Summer ’26", image: sanFranciscoCover, alt: "A corner bookshop in San Francisco.", accent: "#ffd60a", title: "#b9ac48" },
  { href: "/photos/new-york/", code: "NYC", place: "New York", season: "Summer ’26", image: nycCover, alt: "Walkers on the Brooklyn Bridge promenade toward its stone tower.", accent: "#ffd60a", title: "#b9ac48" },
  { href: "/photos/new-zealand/", code: "NZ W", place: "New Zealand", season: "Winter ’26", image: nzWinterCover, alt: "A lakeside beach and snow-capped mountains at dusk.", accent: "#8fd4ff", title: "#78a0c2" },
  { href: "/photos/melbourne-autumn/", code: "MEL A", place: "Melbourne", season: "Autumn ’26", image: melbourneAutumnCover, alt: "Melbourne skyline at sunset.", accent: "#f4a259", title: "#af7e45" },
  { href: "/photos/new-zealand-autumn/", code: "NZ A", place: "New Zealand", season: "Autumn ’26", image: nzAutumnCover, alt: "A panorama of jagged peaks from a stony ridge in Arthur's Pass.", accent: "#f4a259", title: "#af7e45" },
  { href: "/photos/japan/", code: "JPN", place: "Japan", season: "Winter ’25", image: japanCover, alt: japanPhotos[0].alt, accent: "#8fd4ff", title: "#78a0c2" },
].filter((trip) => trip.image);
---

<Layout title="Photos — Naman" description="Photo diaries from every trip.">
  <section class="photos-page">
    <header><h1>photos</h1><span>{trips.length} trips · a few places, through my lens</span></header>
    <div class="trip-picker" style={`--active-accent: ${trips[0].accent}`}>
      <div class="trip-stage">
        {trips.map((trip, index) => (
          <a href={trip.href} class:list={["featured-trip", { "is-active": index === 0 }]} data-feature={index} style={`--trip-accent: ${trip.accent}; --trip-title: ${trip.title};`} aria-hidden={index !== 0 ? "true" : undefined} tabindex={index === 0 ? 0 : -1} aria-label={`Open ${trip.place}, ${trip.season}`}>
            <Image src={trip.image!} alt={trip.alt} widths={[800, 1200, 1600]} sizes="(min-width: 640px) 560px, 90vw" quality={88} format="webp" loading={index === 0 ? "eager" : "lazy"} style={`object-position: ${trip.focus ?? "50% 50%"}`} />
            <span class="feature-shade"></span>
            <span class="feature-copy"><span class="eyebrow">{trip.season}</span><span class="feature-place">{trip.place}</span><span class="open-gallery">open diary ↗</span></span>
          </a>
        ))}
      </div>
      <div class="dial-orbit" style={`--count: ${trips.length}`}>
        <span class="orbit-track" aria-hidden="true"></span>
        <div class="dial-wrap">
          <span class="dial-pointer" aria-hidden="true"></span>
          <div class="camera-dial" role="group" aria-label="Choose a trip">
            {trips.map((trip, index) => (
              <div class="dial-position" style={`--position: ${index * 360 / trips.length}deg`}>
                <button class="dial-stop" data-trip={index} data-accent={trip.accent} data-label={`${trip.place} · ${trip.season}`} aria-pressed={index === 0} aria-label={`${trip.place}, ${trip.season}`}><span>{trip.code}</span></button>
              </div>
            ))}
          </div>
          <div class="dial-hub" aria-hidden="true">TRIPS</div>
        </div>
        {trips.map((trip, index) => (
          <button class="mini-trip" data-mini={index} style={`--position: ${index * 360 / trips.length}deg; --trip-accent: ${trip.accent}; --trip-title: ${trip.title};`} aria-pressed={index === 0} aria-hidden={index === 0 ? "true" : undefined} tabindex={index === 0 ? -1 : 0} aria-label={`Select ${trip.place}, ${trip.season}`}>
            <span class="mini-card">
              <Image src={trip.image!} alt="" widths={[240, 480]} sizes="140px" format="webp" loading="eager" style={`object-position: ${trip.focus ?? "50% 50%"}`} />
              <span><strong>{trip.place}</strong><small>{trip.season}</small></span>
            </span>
          </button>
        ))}
      </div>
      {/* Announces the selected trip to screen readers; the dial and card show it visually. */}
      <p class="selected-label sr-only" aria-live="polite" aria-atomic="true">{trips[0].place} · {trips[0].season}</p>
    </div>
  </section>
</Layout>

<script>
  const picker = document.querySelector<HTMLElement>(".trip-picker")!;
  const dial = picker.querySelector<HTMLElement>(".camera-dial")!;
  const stops = Array.from(picker.querySelectorAll<HTMLButtonElement>("[data-trip]"));
  const cards = Array.from(picker.querySelectorAll<HTMLAnchorElement>("[data-feature]"));
  const minis = Array.from(picker.querySelectorAll<HTMLButtonElement>("[data-mini]"));
  const orbit = picker.querySelector<HTMLElement>(".dial-orbit")!;
  let selected = 0;
  let rotation = 0;
  function select(index: number) {
    const next = (index + stops.length) % stops.length;
    let distance = next - selected;
    if (distance > stops.length / 2) distance -= stops.length;
    if (distance < -stops.length / 2) distance += stops.length;
    rotation -= distance * 360 / stops.length;
    selected = next;
    dial.style.setProperty("--rotation", `${rotation}deg`);
    orbit.style.setProperty("--rotation", `${rotation}deg`);
    picker.style.setProperty("--active-accent", stops[next].dataset.accent!);
    stops.forEach((stop, i) => stop.setAttribute("aria-pressed", String(i === next)));
    minis.forEach((mini, i) => {
      mini.setAttribute("aria-pressed", String(i === next));
      if (i === next) mini.setAttribute("aria-hidden", "true"); else mini.removeAttribute("aria-hidden");
      mini.tabIndex = i === next ? -1 : 0;
    });
    cards.forEach((card, i) => {
      card.classList.toggle("is-active", i === next);
      card.setAttribute("aria-hidden", String(i !== next));
      card.tabIndex = i === next ? 0 : -1;
    });
    picker.querySelector(".selected-label")!.textContent = stops[next].dataset.label!;
  }
  stops.forEach((stop, i) => stop.addEventListener("click", () => select(i)));
  minis.forEach((mini, i) => mini.addEventListener("click", () => select(i)));
  picker.querySelectorAll<HTMLButtonElement>("[data-step]").forEach(button => button.addEventListener("click", () => select(selected + Number(button.dataset.step))));
  dial.addEventListener("keydown", event => {
    if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown", "Home", "End"].includes(event.key)) return;
    event.preventDefault();
    select(event.key === "Home" ? 0 : event.key === "End" ? stops.length - 1 : selected + (["ArrowRight", "ArrowDown"].includes(event.key) ? 1 : -1));
    stops[selected].focus({ preventScroll: true });
  });
  // Arrow keys turn the dial from anywhere on the page, not only when it has focus.
  document.addEventListener("keydown", event => {
    if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey) return;
    if (!["ArrowLeft", "ArrowRight"].includes(event.key)) return;
    const target = event.target;
    if (target instanceof Element && target.closest("input, textarea, select, [contenteditable], details[open]")) return;
    event.preventDefault();
    select(selected + (event.key === "ArrowRight" ? 1 : -1));
  });
</script>

<style>
  .photos-page { max-width: 1080px; margin: auto; padding: 36px 24px 72px; }
  header { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 38px; }
  h1 { font: 800 36px/.95 "Inter Tight", "Inter", sans-serif; letter-spacing: -.05em; margin: 0; }
  header > span { font: 10px/1.5 monospace; color: var(--color-paper-dim); }
  .trip-stage { position: relative; width: min(100%, 560px); aspect-ratio: 16/10; margin: auto; }
  .featured-trip { position: absolute; inset: 0; border-radius: 14px; overflow: hidden; opacity: 0; visibility: hidden; transform: translateY(18px) scale(.95); transition: opacity .4s, transform .5s, visibility .4s; text-decoration: none; }
  .featured-trip.is-active { opacity: 1; visibility: visible; transform: translateY(0) scale(1); box-shadow: 0 0 0 1px color-mix(in srgb, var(--active-accent) 50%, transparent), 0 12px 60px color-mix(in srgb, var(--active-accent) 17%, transparent); }
  .featured-trip img { width: 100%; height: 100%; object-fit: cover; }
  .feature-shade { position: absolute; inset: 0; background: linear-gradient(transparent 30%, #000b); }
  .feature-copy { position: absolute; inset: auto 28px 26px; display: flex; flex-direction: column; align-items: flex-start; gap: 9px; }
  .eyebrow { font: 11px monospace; text-transform: uppercase; letter-spacing: .13em; color: var(--trip-accent); }
  .feature-place { font: 800 clamp(32px, 5vw, 52px)/.95 "Inter Tight", "Inter", sans-serif; letter-spacing: -.045em; color: var(--trip-title); text-shadow: 0 2px 18px rgb(0 0 0 / 35%); }
  .open-gallery { position: absolute; bottom: 0; right: 0; font: 11px monospace; color: #fff; }
  /* The dial sits in the middle of a ring of trip cards. Cards orbit with the
     dial; the trip in focus sits at the top under the pointer and fades out. */
  /* --cy is the dial centre: low enough that the cards beside the top slot
     clear the trip card above, for any number of trips. */
  .dial-orbit { --rotation: 0deg; --radius: 190px; --card-w: 128px; --card-h: 92px; --cy: max(112px, calc(var(--radius) * cos(360deg / var(--count)) + var(--card-h) / 2 + 6px)); position: relative; height: calc(var(--cy) + var(--radius) + var(--card-h) / 2 + 8px); margin-top: 22px; }
  .orbit-track { position: absolute; left: 50%; top: var(--cy); width: calc(var(--radius) * 2); height: calc(var(--radius) * 2); translate: -50% -50%; border-radius: 50%; border: 1px dashed #ffffff14; pointer-events: none; mask: linear-gradient(transparent 0 22%, #000 34%); }
  .dial-wrap { position: absolute; left: calc(50% - 95px); top: calc(var(--cy) - 95px); width: 190px; height: 190px; z-index: 1; }
  /* Modelled on the Fujifilm FILM dial: a black disc with a knurled rim,
     thick white labels fixed to the disc (they turn with it, so the selected
     trip reads level at the top), the selected one boxed in white, and a
     fixed black hub with a white oval index pointing at it. */
  .dial-pointer { position: absolute; top: calc(50% - 34px + 7px); left: 50%; z-index: 2; width: 12px; height: 6px; margin-left: -6px; border-radius: 3px; background: #fff; box-shadow: 0 0 0 1px #000; }
  .camera-dial { --rotation: 0deg; position: absolute; inset: 0; border-radius: 50%; background: #050505; box-shadow: 0 0 0 1px #000, 0 10px 22px rgba(0,0,0,.6); transform: rotate(var(--rotation)); transition: transform 420ms cubic-bezier(.22,1,.36,1); }
  /* Outer ring in pebbled dark brown leather, textured like the Instax Mini
     Evo body (grain drawn with an SVG noise filter). */
  .camera-dial::before { content: ""; position: absolute; inset: 0; border-radius: 50%; pointer-events: none;
    background: radial-gradient(closest-side, transparent 88.6%, rgba(0,0,0,.55) 89.4%, transparent 91.5%), url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='90' height='90'><filter id='p' x='0' y='0' width='100%' height='100%'><feTurbulence type='fractalNoise' baseFrequency='.6' numOctaves='2' seed='7' stitchTiles='stitch'/><feDiffuseLighting surfaceScale='1.3' lighting-color='%23fff'><feDistantLight azimuth='225' elevation='62'/></feDiffuseLighting><feComponentTransfer><feFuncR type='linear' slope='.45' intercept='.6'/><feFuncG type='linear' slope='.45' intercept='.6'/><feFuncB type='linear' slope='.45' intercept='.6'/></feComponentTransfer><feBlend in2='SourceGraphic' mode='multiply'/></filter><rect width='90' height='90' fill='%234a2a1a' filter='url(%23p)'/></svg>") 0 0 / 90px 90px, #45271a;
    box-shadow: inset 0 0 0 1px rgba(0,0,0,.45), inset 0 2px 3px rgba(255,220,190,.18);
    mask: radial-gradient(closest-side, transparent 88.6%, #000 89%); }
  /* Polished silver bezel around the leather, like the Instax's metal trim.
     Fixed (it sits on .dial-wrap), so the sheen stays put while the dial turns. */
  .dial-wrap::before { content: ""; position: absolute; inset: -5px; border-radius: 50%; pointer-events: none;
    background: conic-gradient(from 20deg, #f4f4f2, #a3a3a0 12%, #e9e9e6 24%, #8f8f8c 37%, #f7f7f5 50%, #a0a09d 62%, #e4e4e1 75%, #8d8d8a 88%, #f4f4f2);
    box-shadow: 0 0 0 1px rgba(0,0,0,.6), inset 0 0 0 1px rgba(255,255,255,.35), 0 10px 22px rgba(0,0,0,.55);
    mask: radial-gradient(closest-side, transparent calc(100% - 5.5px), #000 calc(100% - 5px)); }
  .dial-position { position: absolute; inset: 0; transform: rotate(var(--position)); pointer-events: none; }
  /* Labels run along the radius and read outwards, ending at the rim. */
  .dial-stop { position: absolute; top: 15px; left: calc(50% - 13px); width: 26px; height: 46px; padding: 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; background: none; border: 0; pointer-events: auto; cursor: pointer; color: #fff; }
  .dial-stop span { display: block; writing-mode: vertical-rl; transform: rotate(180deg); padding: 4px 2px 4px 1px; border-radius: 2px; white-space: nowrap; font: 800 12px / 1 "Inter Tight", "Inter", ui-sans-serif, system-ui, sans-serif; letter-spacing: .01em; transition: background-color 200ms ease, color 200ms ease; }
  .dial-stop[aria-pressed="true"] span { background: #fff; color: #050505; }
  @media (hover: hover) and (pointer: fine) { .dial-stop:not([aria-pressed="true"]):hover span { box-shadow: inset 0 0 0 1.5px #fff; } }
  .dial-hub { position: absolute; top: 50%; left: 50%; width: 68px; height: 68px; transform: translate(-50%, -50%); border-radius: 50%; display: grid; place-items: center; background: radial-gradient(circle at 40% 30%, #161616 0%, #000 65%); border: 1px solid #000; box-shadow: 0 0 0 1px #1a1a1a, 0 3px 8px rgba(0,0,0,.7); font: 800 14px / 1 "Inter Tight", "Inter", ui-sans-serif, system-ui, sans-serif; letter-spacing: .03em; color: #fff; pointer-events: none; }
  .mini-trip { --angle: calc(var(--position) + var(--rotation)); position: absolute; left: calc(50% - var(--card-w) / 2); top: calc(var(--cy) - var(--card-h) / 2); width: var(--card-w); height: var(--card-h); padding: 0; border: 0; background: none; cursor: pointer; transform: rotate(var(--angle)) translateY(calc(-1 * var(--radius))) rotate(calc(-1 * var(--angle))); transition: transform 420ms cubic-bezier(.22,1,.36,1), opacity .35s; }
  .mini-card { position: absolute; inset: 0; display: block; border: 1px solid #ffffff14; border-radius: 8px; overflow: hidden; background: #111; text-align: left; transition: border-color .3s, scale .3s; }
  .mini-card img { width: 100%; height: 100%; object-fit: cover; opacity: .2; transition: opacity .3s; }
  .mini-card > span { position: absolute; inset: auto 10px 9px; display: flex; flex-direction: column; gap: 3px; color: #ddd; }
  /* Trips out of focus stay dim; the trip colours are muted toward grey until hover. */
  .mini-trip strong { font: 700 12px "Inter Tight", "Inter", sans-serif; color: color-mix(in srgb, var(--trip-title) 45%, #3a3a3a); transition: color .3s; }
  .mini-trip small { font: 9px monospace; color: color-mix(in srgb, var(--trip-accent) 40%, #3a3a3a); transition: color .3s; }
  .mini-trip:hover .mini-card { border-color: color-mix(in srgb, var(--active-accent) 60%, transparent); scale: 1.05; }
  .mini-trip:hover img { opacity: .55; }
  .mini-trip:hover strong { color: var(--trip-title); }
  .mini-trip:hover small { color: var(--trip-accent); }
  .mini-trip[aria-pressed="true"] { opacity: 0; pointer-events: none; }
  button:focus-visible, a:focus-visible { outline: 2px solid var(--active-accent); outline-offset: 5px; }
  @media (max-width: 600px) {
    header > span { max-width: 140px; text-align: right; }
    .feature-copy { inset: auto 20px 20px; }
    .open-gallery { position: static; margin-top: 4px; }
    .dial-orbit { --radius: 128px; --card-w: 78px; --card-h: 58px; }
    .dial-wrap { scale: .8; }
    .mini-card > span { inset: auto 6px 5px; }
    .mini-trip strong { font-size: 10px; }
    .mini-trip small { font-size: 8px; }
  }
  @media (prefers-reduced-motion: reduce) { *, *::before { transition: none !important; } }
</style>
