---
// Japan, Winter '25. Layout lives in TripGallery.astro (same as NYC).
// Photo data mirrors the Notion photo library (src/data/japan-photos.ts);
// images are src/assets/photos/japan-2025/<Photo ID>.jpg.
import TripGallery from "../../components/TripGallery.astro";
import { japanPhotos } from "../../data/japan-photos";

const files = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/photos/japan-2025/*.{jpg,jpeg}",
  { eager: true },
);
const photos = japanPhotos
  .map((photo) => ({
    id: photo.id,
    alt: photo.alt,
    image: (files[`/src/assets/photos/japan-2025/${photo.id}.jpg`] ?? files[`/src/assets/photos/japan-2025/${photo.id}.jpeg`])?.default,
  }))
  .filter((photo): photo is typeof photo & { image: ImageMetadata } => Boolean(photo.image));
---

<TripGallery
  title="Japan — Naman"
  slug="japan"
  season="winter ’25"
  photos={photos}
  accent={{ onDark: "#8fd4ff", onLight: "#1a73a8" }}
/>
