---
// New Zealand, Winter '26. Layout lives in TripGallery.astro (same as NYC).
// Photo IDs and order match the New Zealand rows of the Notion photo library.
import TripGallery from "../../components/TripGallery.astro";
import mountainRoad from "../../assets/photos/featured/mountain-road.jpg";
import mountainTrail from "../../assets/photos/featured/mountain-trail.jpg";
import suspensionBridge from "../../assets/photos/featured/suspension-bridge.jpg";
import bridgeView from "../../assets/photos/featured/bridge-view.jpg";
import forestRidge from "../../assets/photos/featured/forest-ridge.jpg";
import lakeDaylight from "../../assets/photos/featured/lake-daylight.jpg";
import lakeDusk from "../../assets/photos/featured/lake-dusk.jpg";

const photos = [
  { id: "nz-mountain-road", image: mountainRoad, alt: "A winding mountain road above a broad valley beneath a cloudy sky." },
  { id: "nz-mountain-trail", image: mountainTrail, alt: "A hillside trail overlooking a valley and snow-dusted mountain peaks." },
  { id: "nz-suspension-bridge", image: suspensionBridge, alt: "A suspension bridge tower in front of snowy mountains and bare trees." },
  { id: "nz-bridge-view", image: bridgeView, alt: "A wooden suspension bridge crossing a river toward a mountain meadow." },
  { id: "nz-forest-ridge", image: forestRidge, alt: "A steep forest-covered rocky ridge against a clear blue sky." },
  { id: "nz-lake-daylight", image: lakeDaylight, alt: "Snow-dusted mountains above a blue lake, with trees in the foreground under a clear sky." },
  { id: "nz-lake-dusk", image: lakeDusk, alt: "A lakeside beach and snow-capped mountains beneath a soft pink evening sky." },
];
---

<TripGallery
  title="New Zealand — Naman"
  slug="new-zealand"
  season="winter ’26"
  photos={photos}
  accent={{ onDark: "#8fd4ff", onLight: "#1a73a8" }}
/>
