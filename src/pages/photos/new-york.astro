---
import PhotoMap from "../../components/PhotoMap.astro";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import photo0 from "../../assets/photos/new-york/park-arch.jpg";
import photo1 from "../../assets/photos/new-york/street-corner.jpg";
import photo2 from "../../assets/photos/new-york/window-view.jpg";

import photo3 from "../../assets/photos/new-york/court-square.jpg";
import photo4 from "../../assets/photos/new-york/brick-facade.jpg";
import photo5 from "../../assets/photos/new-york/city-street.jpg";
import photo6 from "../../assets/photos/new-york/rooftops.jpg";
import photo7 from "../../assets/photos/new-york/coffee-shop.jpg";
import photo8 from "../../assets/photos/new-york/brooklyn-bridge.jpg";
import photo9 from "../../assets/photos/new-york/centre-street.jpg";
import photo10 from "../../assets/photos/new-york/chinatown-billboard.jpg";
import photo11 from "../../assets/photos/new-york/city-hall-park.jpg";
import photo12 from "../../assets/photos/new-york/garden-gate.jpg";
import photo13 from "../../assets/photos/new-york/magazine-shop.jpg";
import photo14 from "../../assets/photos/new-york/sheep-meadow.jpg";
import photo15 from "../../assets/photos/new-york/manhattan-bridge-dumbo.jpg";

const photos = [
  { image: photo0, alt: "A person walking beside a stone arch in a leafy New York park.", caption: "Washington Square Park, Greenwich Village", tags: ["buildings"] },
  { image: photo1, alt: "An ivy-covered brick building and traffic lights on a sunny New York street.", caption: "E 19th & Irving Place, Gramercy Park", tags: ["buildings"] },
  { image: photo2, alt: "A view through a window of a fire escape, leafy trees and brick apartment buildings.", caption: "E 29th & 3rd Av, Kips Bay", tags: ["buildings"] },
  { image: photo3, alt: "A passenger seated on the Court Square station platform beneath surrounding city buildings.", caption: "Court Square Station, Long Island City", tags: ["buildings"] },
  { image: photo4, alt: "An ornate red and cream brick apartment building with fire escapes and storefronts.", caption: "219 Madison Street, Lower East Side", tags: ["buildings"] },
  { image: photo5, alt: "Brick buildings with metal fire escapes beside taller towers on a New York street.", caption: "Lafayette St & Prince St, Soho", tags: ["buildings"] },
  { image: photo6, alt: "A view over New York rooftops, water towers and terraces beneath a blue sky.", caption: "E14th & 2nd Av, East Village", tags: ["buildings"] },
  { image: photo9, alt: "One World Trade Center rising between an ornate brick building and a gilded corner building, with a cyclist crossing the street.", caption: "Centre Street, Civic Center", tags: ["buildings"] },
  { image: photo7, alt: "Customers at the counter and seated inside a wood-panelled coffee shop, with a framed skyline photograph on the wall.", caption: "PARK at KIMS, Chinatown", tags: ["cafes"] },
  { image: photo10, alt: "A giant AT&T billboard of a dog holding an iPhone above a busy Centre Street intersection, with an NYPD car in the foreground.", caption: "Centre Street, Chinatown", tags: ["buildings"] },
  { image: photo8, alt: "People walking along the Brooklyn Bridge's wooden promenade toward its Gothic stone tower, with the Manhattan skyline behind.", caption: "Brooklyn Bridge, DUMBO", tags: ["bridges"] },
  { image: photo11, alt: "One World Trade Center's spire seen between buildings near a limestone civic building, framed by a tree.", caption: "City Hall Park, Civic Center", tags: ["buildings"] },
  { image: photo14, alt: "A crowded lawn in Central Park with a row of Midtown skyscrapers rising behind the trees.", caption: "Sheep Meadow, Central Park", tags: ["green"] },
  { image: photo12, alt: "A wisteria-draped iron gate opening onto a shaded community garden path.", caption: "Jefferson Market Garden, West Village", tags: ["green"] },
  { image: photo15, alt: "The Manhattan Bridge's towers and cables seen from a Brooklyn rooftop across the East River.", caption: "Manhattan Bridge, DUMBO", tags: ["bridges"] },
  { image: photo13, alt: "The interior of Air Mail, a stationery and magazine store, with wall-to-wall shelves of titles and a mid-century sitting area.", caption: "Air Mail, West Village", tags: ["cafes"] },
];

const splitCaption = (caption: string) => {
  const commaIndex = caption.indexOf(",");
  if (commaIndex === -1) return { top: caption, bottom: null };
  return { top: caption.slice(0, commaIndex), bottom: caption.slice(commaIndex + 1).trim() };
};
---

<Layout title="New York — Naman">
  <section class="mx-auto max-w-3xl px-6 pt-8 pb-8 text-center sm:px-10 sm:pt-10 sm:pb-10">
    <h1 class="city-title font-heading text-[56px] leading-none text-paper sm:text-[80px]" aria-label="new york city">
      <span>new</span> <span>york</span> <span>city</span>
    </h1>
  </section>

  <div class="top-controls mx-auto max-w-6xl px-6 sm:px-10">
    <div class="view-selector">
      <span class="gallery-word">gallery</span>
      <button id="map-toggle" type="button" role="switch" aria-checked="false" aria-label="Map view" aria-controls="photo-gallery map-panel"><span></span></button>
      <span class="map-word">map</span>
    </div>
    <div class="filter-wheel-wrap">
      <div class="filter-wheel" id="filter-wheel" role="tablist" aria-label="Photo category filters">
        {["cafes", "bridges", "green", "buildings"].map((label) => (
          <button type="button" class="filter-item" role="tab" data-filter={label}>{label}</button>
        ))}
      </div>
    </div>
  </div>

  <PhotoMap />
  <section id="photo-gallery" aria-label="Photos" class="mx-auto max-w-6xl px-6 pb-24 sm:px-10">
    <div class="columns-1 gap-6 sm:columns-2 sm:gap-8">
      {photos.map((photo, index) => (
        <figure data-expand-portrait="true" data-caption={photo.caption} data-tags={photo.tags.join(" ")} role="button" aria-label={`Enlarge ${photo.caption} photo`} aria-haspopup="dialog" tabindex={photo.caption ? 0 : undefined} class="photo-card relative mb-6 break-inside-avoid overflow-hidden sm:mb-8 rounded-[12px] bg-ink-soft">
          <Image
            src={photo.image}
            alt={photo.alt}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 1152px) 520px, (min-width: 640px) 50vw, 100vw"
            format="webp"
            loading={index < 2 ? "eager" : "lazy"}
            class="block h-auto w-full"
          />
          {photo.caption && (
            <>
              <figcaption class="photo-caption pointer-events-none absolute inset-x-0 top-0 bg-gradient-to-b from-black/60 to-transparent px-6 pt-5 pb-14 text-center font-sans text-sm font-light text-white/90">
                {splitCaption(photo.caption).top}
              </figcaption>
              {splitCaption(photo.caption).bottom && (
                <figcaption class="photo-caption pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent px-6 pt-14 pb-5 text-center font-sans text-sm font-light text-white/90">
                  {splitCaption(photo.caption).bottom}
                </figcaption>
              )}
            </>
          )}
        </figure>
      ))}
    </div>
  </section>
  <dialog id="portrait-view" aria-label="Washington Square Park photograph">
    <div class="portrait-stage">
      <Image src={photo0} alt={photos[0].alt} widths={[800, 1200, 1600]} sizes="90vw" format="webp" class="portrait-large" />
      <p class="portrait-label">
        <span class="block">{splitCaption(photos[0].caption).top}</span>
        {splitCaption(photos[0].caption).bottom && (
          <span class="block">{splitCaption(photos[0].caption).bottom}</span>
        )}
      </p>
      <button type="button" class="portrait-close" aria-label="Close enlarged photo" autofocus>×</button>
    </div>
  </dialog>
</Layout>

<script>
  const triggers = document.querySelectorAll<HTMLElement>("[data-expand-portrait]");
  let trigger: HTMLElement | undefined;
  const viewer = document.querySelector<HTMLDialogElement>("#portrait-view");
  const stage = viewer?.querySelector<HTMLElement>(".portrait-stage");
  let oldOverflow = "";
  let closing = false;
  let openedWithKeyboard = false;
  let motion: Animation | undefined;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  function thumbnailTransform() {
    const source = trigger?.querySelector("img")?.getBoundingClientRect();
    const target = viewer?.querySelector(".portrait-large")?.getBoundingClientRect();
    if (!source || !target) return "none";
    return `translate(${source.left - target.left}px, ${source.top - target.top}px) scale(${source.width / target.width}, ${source.height / target.height})`;
  }
  function closePortrait() {
    if (!viewer?.open || !stage || closing) return;
    closing = true;
    motion?.finish();
    const destination = thumbnailTransform();
    viewer.classList.add("is-closing");
    motion = stage.animate([{ transform: "none" }, { transform: destination }], {
      duration: reducedMotion.matches ? 0 : 300,
      easing: "cubic-bezier(0.4, 0, 0.2, 1)", fill: "forwards",
    });
    motion.onfinish = () => {
      viewer.close();
      motion?.cancel();
    };
  }
  function openPortrait(card: HTMLElement) {
    if (!viewer || viewer.open || !stage) return;
    const thumbnail = card.querySelector("img");
    const enlarged = viewer.querySelector<HTMLImageElement>(".portrait-large");
    if (!thumbnail || !enlarged) return;
    trigger = card;
    enlarged.srcset = thumbnail.srcset;
    enlarged.sizes = "90vw";
    enlarged.src = thumbnail.src;
    enlarged.alt = thumbnail.alt;
    enlarged.width = thumbnail.width;
    enlarged.height = thumbnail.height;
    const ratio = Number(thumbnail.getAttribute("width")) / Number(thumbnail.getAttribute("height"));
    stage.style.width = `min(90vw, ${88 * ratio}dvh)`;
    const label = viewer.querySelector<HTMLElement>(".portrait-label");
    if (label) {
      const caption = card.dataset.caption ?? "";
      const commaIndex = caption.indexOf(",");
      const top = commaIndex === -1 ? caption : caption.slice(0, commaIndex);
      const bottom = commaIndex === -1 ? "" : caption.slice(commaIndex + 1).trim();
      label.innerHTML = "";
      const topSpan = document.createElement("span");
      topSpan.className = "block";
      topSpan.textContent = top;
      label.append(topSpan);
      if (bottom) {
        const bottomSpan = document.createElement("span");
        bottomSpan.className = "block";
        bottomSpan.textContent = bottom;
        label.append(bottomSpan);
      }
    }
    viewer.setAttribute("aria-label", `${card.dataset.caption ?? "Enlarged"} photograph`);
    closing = false;
    viewer.classList.remove("is-closing");
    oldOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    viewer.showModal();
    if (stage && trigger) {
      const origin = thumbnailTransform();
      trigger.style.visibility = "hidden";
      motion = stage.animate([{ transform: origin }, { transform: "none" }], {
        duration: reducedMotion.matches ? 0 : 420,
        easing: "cubic-bezier(0.22, 1, 0.36, 1)", fill: "both",
      });
    }
  }
  triggers.forEach((card) => {
    card.addEventListener("click", (event) => {
      openedWithKeyboard = event.detail === 0;
      openPortrait(card);
    });
    card.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        openedWithKeyboard = true;
        openPortrait(card);
      }
    });
  });
  viewer?.querySelector("button")?.addEventListener("click", () => closePortrait());
  viewer?.addEventListener("click", (event) => {
    if (event.target === viewer) closePortrait();
  });
  viewer?.addEventListener("cancel", (event) => {
    event.preventDefault();
    closePortrait();
  });
  viewer?.addEventListener("close", () => {
    if (trigger) trigger.style.visibility = "";
    document.body.style.overflow = oldOverflow;
    if (openedWithKeyboard) trigger?.focus({ preventScroll: true });
    else trigger?.blur();
  });
</script>

<style is:inline>
  [data-expand-portrait] { cursor: zoom-in; }
  #portrait-view {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }
  #portrait-view[open] { display: grid; place-items: center; }
  #portrait-view::backdrop {
    background: rgb(0 0 0 / 88%);
    backdrop-filter: blur(6px);
    animation: backdrop-in 200ms ease both;
  }
  .portrait-stage {
    position: relative;
    width: min(90vw, 49.5dvh);
    transform-origin: top left;
  }
  .portrait-large { display: block; width: 100%; height: auto; max-height: 88dvh; object-fit: contain; border-radius: 12px; }
  .portrait-label { position: absolute; bottom: 0; inset-inline: 0; padding: 48px 24px 20px; background: linear-gradient(transparent, rgb(0 0 0 / 60%)); color: rgb(255 255 255 / 90%); font-size: 14px; font-weight: 300; border-radius: 0 0 12px 12px; }
  .portrait-close { position: absolute; right: 12px; top: 12px; display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; padding: 0; border: none; border-radius: 50%; background: rgb(0 0 0 / 45%); color: white; font-size: 24px; line-height: 1; cursor: pointer; }
  #portrait-view.is-closing::backdrop { animation: backdrop-out 300ms ease both; }
  #portrait-view.is-closing .portrait-close { opacity: 0; }
  @keyframes backdrop-out { from { opacity: 1; } to { opacity: 0; } }
  @keyframes backdrop-in { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .portrait-stage, #portrait-view::backdrop { animation: none; }
  }

  .photo-caption {
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 240ms ease, transform 240ms ease;
  }
  .photo-card:hover .photo-caption,
  .photo-card:focus-visible .photo-caption {
    opacity: 1;
    transform: translateY(0);
  }
  @media (hover: none) {
    .photo-caption { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .photo-caption { transition: none; transform: none; }
  }

  .photo-card {
    transition: transform 240ms ease, box-shadow 240ms ease, opacity 180ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .photo-card:hover {
      transform: translateY(-8px) scale(1.025);
      box-shadow: 0 14px 32px rgb(0 0 0 / 12%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-card {
      transition: none;
    }
    .photo-card:hover {
      transform: none;
    }
  }
</style>

<script>
  const wheel = document.getElementById("filter-wheel");
  if (wheel) {
    const items = Array.from(wheel.querySelectorAll<HTMLButtonElement>(".filter-item"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>("#photo-gallery [data-expand-portrait]"));
    // No filter is applied until the visitor actually touches the wheel — the first item
    // simply starts centered, and that shouldn't pre-filter the gallery down to just cafes.
    let hasInteracted = false;
    const reducedMotionFilter = window.matchMedia("(prefers-reduced-motion: reduce)");

    // A longer, eased glide instead of the browser's native (fast, fixed-feel) smooth
    // scroll, so moving between wheel items feels like sliding rather than snapping.
    let glideFrame: number | undefined;
    const glideTo = (item: HTMLElement) => {
      if (glideFrame !== undefined) cancelAnimationFrame(glideFrame);
      const start = wheel.scrollLeft;
      // getBoundingClientRect, not offsetLeft: .filter-wheel isn't a positioned element,
      // so offsetLeft resolves against a distant ancestor and produces a bogus target.
      const wheelRect = wheel.getBoundingClientRect();
      const itemRect = item.getBoundingClientRect();
      const itemCenterInWheel = itemRect.left - wheelRect.left + itemRect.width / 2;
      const target = start + itemCenterInWheel - wheel.clientWidth / 2;
      const distance = target - start;
      if (reducedMotionFilter.matches || distance === 0) {
        wheel.scrollLeft = target;
        return;
      }
      const duration = 620;
      const startTime = performance.now();
      const easeOutQuint = (t: number) => 1 - Math.pow(1 - t, 5);
      const step = (now: number) => {
        const progress = Math.min((now - startTime) / duration, 1);
        wheel.scrollLeft = start + distance * easeOutQuint(progress);
        if (progress < 1) {
          glideFrame = requestAnimationFrame(step);
        } else {
          glideFrame = undefined;
        }
      };
      glideFrame = requestAnimationFrame(step);
    };

    // Guards against rapid successive filter clicks: applyFilter reads each card's
    // current `hidden` state to decide what needs to change, but mid-transition a card
    // is briefly in a "not hidden yet" or "not faded in yet" limbo state. Without
    // flushing the previous transition straight to its end state first, a new click
    // reads that limbo state, misclassifies the card, and it can end up stuck invisible.
    let version = 0;
    let pendingToHide: HTMLElement[] = [];
    let pendingToShow: HTMLElement[] = [];
    let pendingStaying: HTMLElement[] = [];
    const finalizePending = () => {
      pendingToHide.forEach((card) => {
        card.hidden = true;
        card.style.opacity = "";
        card.style.transition = "";
        card.style.transform = "";
      });
      pendingToShow.forEach((card) => {
        card.style.opacity = "";
        card.style.transition = "";
        card.style.transform = "";
      });
      pendingStaying.forEach((card) => {
        card.style.transition = "";
        card.style.transform = "";
      });
      pendingToHide = [];
      pendingToShow = [];
      pendingStaying = [];
    };

    const applyFilter = (tag: string | undefined) => {
      version += 1;
      const myVersion = version;
      finalizePending();

      const toHide: HTMLElement[] = [];
      const toShow: HTMLElement[] = [];
      cards.forEach((card) => {
        const tags = card.dataset.tags?.split(" ").filter(Boolean) ?? [];
        const shouldHide = hasInteracted && !!tag && !tags.includes(tag);
        if (shouldHide && !card.hidden) toHide.push(card);
        if (!shouldHide && card.hidden) toShow.push(card);
      });
      if (toHide.length === 0 && toShow.length === 0) return;

      if (reducedMotionFilter.matches) {
        toHide.forEach((card) => { card.hidden = true; });
        toShow.forEach((card) => { card.hidden = false; });
        return;
      }

      // Cards that stay visible still shift position, because hiding/showing others
      // rebalances the CSS-columns masonry. Record where they are now (FLIP's "First")
      // so that shift can be animated instead of snapping instantly.
      const staying = cards.filter(
        (card) => !card.hidden && !toHide.includes(card) && !toShow.includes(card)
      );
      const first = new Map(staying.map((card) => [card, card.getBoundingClientRect()]));

      // Start the outgoing cards fading out and bring the incoming ones into the layout
      // right away, in their pre-fade-in pose, so the two crossfade. Previously the
      // incoming cards stayed hidden until the outgoing ones had fully faded out, so the
      // whole gallery briefly went blank in between.
      toHide.forEach((card) => {
        card.style.opacity = "0";
      });
      toShow.forEach((card) => {
        card.hidden = false;
        card.style.transition = "none";
        card.style.opacity = "0";
        card.style.transform = "translateY(8px)";
      });

      // FLIP's "Last" + "Invert": jump each staying card back to its old spot with
      // no transition, then "Play": release the transform so it glides to its real,
      // reflowed position instead of the layout snapping there instantly.
      first.forEach((before, card) => {
        const after = card.getBoundingClientRect();
        const dx = before.left - after.left;
        const dy = before.top - after.top;
        if (!dx && !dy) return;
        card.style.transition = "none";
        card.style.transform = `translate(${dx}px, ${dy}px)`;
      });

      pendingToHide = toHide;
      pendingToShow = toShow;
      pendingStaying = staying;

      requestAnimationFrame(() => {
        if (myVersion !== version) return;
        first.forEach((_, card) => {
          card.style.transition = "transform 320ms cubic-bezier(0.4, 0, 0.2, 1)";
          card.style.transform = "";
          card.addEventListener("transitionend", () => { card.style.transition = ""; }, { once: true });
        });
        requestAnimationFrame(() => {
          if (myVersion !== version) return;
          toShow.forEach((card) => {
            card.style.transition = "opacity 280ms ease, transform 280ms ease";
            card.style.opacity = "";
            card.style.transform = "";
            card.addEventListener("transitionend", () => { card.style.transition = ""; }, { once: true });
          });
        });
      });

      window.setTimeout(() => {
        if (myVersion !== version) return;
        toHide.forEach((card) => {
          card.hidden = true;
          card.style.opacity = "";
        });
        pendingToHide = [];
        pendingToShow = [];
        pendingStaying = [];
      }, 180);
    };

    const updateActive = () => {
      const wheelRect = wheel.getBoundingClientRect();
      const center = wheelRect.left + wheelRect.width / 2;
      let closest: HTMLButtonElement | null = null;
      let closestDistance = Infinity;
      items.forEach((item) => {
        const itemRect = item.getBoundingClientRect();
        const itemCenter = itemRect.left + itemRect.width / 2;
        const distance = Math.abs(itemCenter - center);
        // Fade smoothly with distance from center rather than a hard on/off cut.
        const proximity = Math.max(0, 1 - distance / (wheelRect.width / 2));
        item.style.opacity = String(0.3 + proximity * 0.7);
        item.style.transform = `scale(${0.82 + proximity * 0.18})`;
        if (distance < closestDistance) {
          closestDistance = distance;
          closest = item;
        }
      });
      items.forEach((item) => item.setAttribute("aria-selected", String(item === closest)));
      applyFilter(closest?.dataset.filter);
    };

    let frame: number | undefined;
    const scheduleUpdate = () => {
      if (frame !== undefined) return;
      frame = requestAnimationFrame(() => {
        frame = undefined;
        updateActive();
      });
    };

    wheel.addEventListener("scroll", () => {
      hasInteracted = true;
      scheduleUpdate();
    }, { passive: true });
    window.addEventListener("resize", scheduleUpdate);

    items.forEach((item) => {
      item.addEventListener("click", () => {
        hasInteracted = true;
        glideTo(item);
        // Apply immediately rather than waiting on the scroll event: clicking an item that's
        // already centered (e.g. the first item on initial load) causes no scroll movement at
        // all, so the scroll-driven update would otherwise never fire for that click.
        items.forEach((i) => i.setAttribute("aria-selected", String(i === item)));
        applyFilter(item.dataset.filter);
      });
    });

    updateActive();
  }
</script>

<style is:inline>
  .top-controls {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    margin: 0 auto 32px;
  }
  .top-controls .view-selector {
    grid-column: 1;
    justify-self: start;
    margin: 0;
  }
  .top-controls .filter-wheel-wrap {
    grid-column: 2;
    justify-self: center;
  }
  @media (max-width: 640px) {
    .top-controls {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 16px;
    }
    .top-controls .view-selector {
      grid-column: 1;
      justify-self: center;
    }
    .top-controls .filter-wheel-wrap {
      grid-column: 1;
      justify-self: stretch;
      width: 100%;
    }
  }
  .filter-wheel-wrap {
    width: 380px;
    max-width: 380px;
    min-width: 0;
    overflow: hidden;
  }
  .filter-wheel {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-inline: calc(50% - 75px);
  }
  .filter-wheel::-webkit-scrollbar {
    display: none;
  }
  .filter-item {
    flex: 0 0 150px;
    scroll-snap-align: center;
    appearance: none;
    -webkit-appearance: none;
    background: none;
    border: none;
    box-shadow: none;
    outline: none;
    padding: 10px 0;
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: 20px;
    text-align: center;
    color: var(--color-paper);
    cursor: pointer;
    opacity: 0.3;
    transform: scale(0.82);
    transition: opacity 200ms ease, transform 200ms ease, color 200ms ease;
  }
  .filter-item:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .filter-item[aria-selected="true"] {
    color: var(--color-accent);
  }
  @media (hover: hover) and (pointer: fine) {
    /* JS sets opacity/transform inline per scroll position; !important lets hover win over that. */
    .filter-item:hover {
      opacity: 1 !important;
      transform: scale(1.15) !important;
      color: var(--color-accent) !important;
