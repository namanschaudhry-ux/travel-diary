---
import { additionalNewYorkPhotos } from "../../data/new-york-additions";
import PhotoMap from "../../components/PhotoMap.astro";
import MapIntro from "../../components/MapIntro.astro";
import LanguageToggle from "../../components/LanguageToggle.astro";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { wordsAttr } from "../../data/i18n";
import photo0 from "../../assets/photos/new-york/park-arch.jpg";
import photo1 from "../../assets/photos/new-york/street-corner.jpg";
import photo2 from "../../assets/photos/new-york/window-view.jpg";

import photo3 from "../../assets/photos/new-york/court-square.jpg";
import photo4 from "../../assets/photos/new-york/brick-facade.jpg";
import photo5 from "../../assets/photos/new-york/city-street.jpg";
import photo6 from "../../assets/photos/new-york/rooftops.jpg";
import photo7 from "../../assets/photos/new-york/coffee-shop.jpg";
import photo8 from "../../assets/photos/new-york/brooklyn-bridge.jpg";
import photo9 from "../../assets/photos/new-york/centre-street.jpg";
import photo10 from "../../assets/photos/new-york/chinatown-billboard.jpg";
import photo11 from "../../assets/photos/new-york/city-hall-park.jpg";
import photo12 from "../../assets/photos/new-york/garden-gate.jpg";
import photo13 from "../../assets/photos/new-york/magazine-shop.jpg";
import photo14 from "../../assets/photos/new-york/sheep-meadow.jpg";
import photo15 from "../../assets/photos/new-york/manhattan-bridge-dumbo.jpg";
import gramercyNorth from "../../assets/photos/new-york/buildings/img_8787.jpeg";

const photos = [
  { image: gramercyNorth, gps: [40.738178, -73.986061], alt: "A tree-lined street with a cyclist and yellow taxi.", caption: "Gramercy Park North, Gramercy", tags: ["buildings"] },
  { image: photo0, alt: "A person walking beside a stone arch in a leafy New York park.", caption: "Washington Square Park, Greenwich Village", tags: ["buildings"], djiDate: "Sep 4 '26", djiTime: "13:56" },
  { image: photo1, alt: "An ivy-covered brick building and traffic lights on a sunny New York street.", caption: "E 19th & Irving Place, Gramercy Park", tags: ["buildings"] },
  { image: photo2, alt: "A view through a window of a fire escape, leafy trees and brick apartment buildings.", caption: "E 29th & 3rd Av, Kips Bay", tags: ["buildings"] },
  { image: photo3, alt: "A passenger seated on the Court Square station platform beneath surrounding city buildings.", caption: "Court Square Station, Long Island City", tags: ["buildings"], djiDate: "Aug 29 '26", djiTime: "16:37" },
  { image: photo4, alt: "An ornate red and cream brick apartment building with fire escapes and storefronts.", caption: "219 Madison Street, Lower East Side", tags: ["buildings"], djiDate: "Aug 31 '26", djiTime: "07:14" },
  { image: photo5, alt: "Brick buildings with metal fire escapes beside taller towers on a New York street.", caption: "Lafayette St & Prince St, Soho", tags: ["buildings"], djiDate: "Aug 31 '26", djiTime: "08:32" },
  { image: photo6, alt: "A view over New York rooftops, water towers and terraces beneath a blue sky.", caption: "E14th & 2nd Av, East Village", tags: ["buildings"], djiDate: "Sep 4 '26", djiTime: "16:13" },
  { image: photo9, alt: "One World Trade Center rising between an ornate brick building and a gilded corner building, with a cyclist crossing the street.", caption: "Centre Street, Civic Center", tags: ["buildings"], djiDate: "Aug 26 '26", djiTime: "07:20" },
  { image: photo7, alt: "Customers at the counter and seated inside a wood-panelled coffee shop, with a framed skyline photograph on the wall.", caption: "PARK at KIMS, Chinatown", tags: ["cafes"], djiDate: "Aug 31 '26", djiTime: "08:23" },
  { image: photo10, alt: "A giant AT&T billboard of a dog holding an iPhone above a busy Centre Street intersection, with an NYPD car in the foreground.", caption: "Centre Street, Chinatown", tags: ["buildings"] },
  { image: photo8, alt: "People walking along the Brooklyn Bridge's wooden promenade toward its Gothic stone tower, with the Manhattan skyline behind.", caption: "Brooklyn Bridge, DUMBO", tags: ["bridges"], djiDate: "Aug 25 '26", djiTime: "07:02" },
  { image: photo11, alt: "One World Trade Center's spire seen between buildings near a limestone civic building, framed by a tree.", caption: "City Hall Park, Civic Center", tags: ["buildings"] },
  { image: photo14, alt: "A crowded lawn in Central Park with a row of Midtown skyscrapers rising behind the trees.", caption: "Sheep Meadow, Central Park", tags: ["green"] },
  { image: photo12, alt: "A wisteria-draped iron gate opening onto a shaded community garden path.", caption: "Jefferson Market Garden, West Village", tags: ["green"] },
  { image: photo15, alt: "The Manhattan Bridge's towers and cables seen from a Brooklyn rooftop across the East River.", caption: "Manhattan Bridge, DUMBO", tags: ["bridges"] },
  { image: photo13, alt: "The interior of Air Mail, a stationery and magazine store, with wall-to-wall shelves of titles and a mid-century sitting area.", caption: "Air Mail, West Village", tags: ["cafes"] },
  ...additionalNewYorkPhotos,
];

// House rule: two portrait ("vertical") photos must never sit side by side.
// Holding that everywhere would need at least as much landscape height as
// portrait height to flank them with, and this set runs about three times the
// other way, so the rule cannot survive the full length of the page. The two
// columns are therefore packed here rather than left to CSS column balancing:
// landscapes are spent near the top, so what breaks the rule collects at the
// bottom where it is least visible. The gallery shows one tag at a time and
// hidden figures leave the layout, so each tag is packed on its own.
type GalleryPhoto = (typeof photos)[number];

// Height of a photo once scaled to the column width, in column widths.
const spanOf = (photo: GalleryPhoto) => photo.image.height / photo.image.width;
const isPortrait = (photo: GalleryPhoto) => photo.image.height > photo.image.width;

function packIntoColumns(group: GalleryPhoto[]): [GalleryPhoto[], GalleryPhoto[]] {
  const columns = [
    { items: [] as GalleryPhoto[], height: 0 },
    { items: [] as GalleryPhoto[], height: 0 },
  ];
  const queue = [...group];

  while (queue.length > 0) {
    // Always feed the shorter column, the way a masonry layout would.
    const target = columns[0].height <= columns[1].height ? columns[0] : columns[1];
    const neighbour = target === columns[0] ? columns[1] : columns[0];

    // Would this photo land level with a portrait in the other column?
    const clashes = (photo: GalleryPhoto) => {
      if (!isPortrait(photo)) return false;
      const top = target.height;
      const bottom = top + spanOf(photo);
      let cursor = 0;
      return neighbour.items.some((placed) => {
        const placedTop = cursor;
        cursor += spanOf(placed);
        return isPortrait(placed) && placedTop < bottom && top < cursor;
      });
    };

    // Keep the curated order wherever the rule allows: take the first photo
    // that fits, and only fall back to the head of the queue once the
    // landscapes have run out and every remaining choice breaks the rule.
    const safe = queue.findIndex((photo) => !clashes(photo));
    const [chosen] = queue.splice(safe === -1 ? 0 : safe, 1);
    target.items.push(chosen);
    target.height += spanOf(chosen);
  }

  return [columns[0].items, columns[1].items];
}

const tagOrder = [...new Set(photos.map((photo) => photo.tags[0]))];
const galleryColumns = tagOrder.reduce<[GalleryPhoto[], GalleryPhoto[]]>(
  ([left, right], tag) => {
    const [a, b] = packIntoColumns(photos.filter((photo) => photo.tags[0] === tag));
    return [[...left, ...a], [...right, ...b]];
  },
  [[], []],
);

const splitCaption = (caption: string) => {
  const commaIndex = caption.indexOf(",");
  if (commaIndex === -1) return { top: caption, bottom: null };
  return { top: caption.slice(0, commaIndex), bottom: caption.slice(commaIndex + 1).trim() };
};

// Small line-art pictograms for the dial rim, matching a camera dial's
// engraved icon tabs rather than printed words.
const photoCategories = ["buildings", "cafes", "bridges", "green", "tennis"];
const categoryStep = 360 / photoCategories.length;

const dialIcons: Record<string, string> = {
  tennis: `<g transform="rotate(40 12 12)"><ellipse cx="12" cy="8" rx="5" ry="6"/><path d="M10 3v10M14 3v10M7 6h10M7 10h10M10 14l2 3 2-3M12 17v5"/></g><circle cx="19" cy="18" r="2"/>`,
  cafes: `<path d="M4 8h13v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8Z"/><path d="M17 9h1.5a2.5 2.5 0 0 1 0 5H17"/><path d="M7 4c0 1-1 1-1 2M11 4c0 1-1 1-1 2"/>`,
  bridges: `<path d="M2 19h20"/><path d="M6 19V6M18 19V6"/><path d="M6 6Q12 14 18 6"/><path d="M9 8V19M12 10.5V19M15 8V19"/>`,
  green: `<path d="M12 3 6 12h3l-4 6h5v3h4v-3h5l-4-6h3L12 3Z"/>`,
  buildings: `<path d="M3 21V9l5-3v15M8 21V6l5-3v18M13 21V11l5-4v14"/><path d="M3 21h18"/>`,
};
---

<Layout title="New York — Naman">
  <MapIntro />
  <div class="top-controls mx-auto max-w-6xl px-6 sm:px-10">
    <div class="left-controls">
    <LanguageToggle />
    <div class="view-selector">
      <span class="gallery-word">gallery</span>
      <button id="map-toggle" type="button" role="switch" aria-checked="false" aria-label="Map view" aria-controls="photo-gallery map-panel"><span></span></button>
      <span class="map-word">map</span>
    </div>
    </div>
    <div class="filter-dial-wrap">
      <div class="camera-dial-pointer" aria-hidden="true"></div>
      <div class="camera-dial" id="filter-dial" role="tablist" aria-label="Photo category filters">
        {photoCategories.map((label, index) => (
          <div class="camera-dial-item" data-filter={label} data-angle={index * categoryStep} style={`transform: rotate(${index * categoryStep}deg);`}>
            <button
              type="button"
              class="camera-dial-label"
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              aria-label={label}
              style={`--counter-rot: ${index * -categoryStep}deg;`}
            >
              <svg class="camera-dial-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={dialIcons[label]} />
            </button>
          </div>
        ))}
      </div>
      <div class="camera-dial-hub" aria-hidden="true">FILM</div>
    </div>
    <h1 class="city-title" aria-label="Summer ’26 — New York City">
      <span class="city-season">summer ’26</span>
      <span
        class="city-words"
        data-i18n-words
        data-i18n-en={wordsAttr("new-york", "en")}
        data-i18n-es={wordsAttr("new-york", "es")}
        data-i18n-fr={wordsAttr("new-york", "fr")}
      >
        <span>new</span><span>york</span><span>city</span>
      </span>
    </h1>
  </div>

  <PhotoMap />
  <section id="photo-gallery" aria-label="Photos" class="mx-auto max-w-6xl px-6 pb-24 sm:px-10">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8">
      {galleryColumns.map((column) => (
      <div>
      {column.map((photo, index) => (
        <figure hidden={!photo.tags.includes("buildings")} data-expand-portrait="true" data-caption={photo.caption} data-lat={"gps" in photo ? photo.gps?.[0] : undefined} data-lng={"gps" in photo ? photo.gps?.[1] : undefined} data-tags={photo.tags.join(" ")} role="button" aria-label={`Enlarge ${photo.caption || photo.alt}`} aria-haspopup="dialog" tabindex="0" class="photo-card relative mb-6 overflow-hidden sm:mb-8 rounded-[12px] bg-ink-soft">
          <Image
            src={photo.image}
            alt={photo.alt}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 1152px) 520px, (min-width: 640px) 50vw, 100vw"
            format="webp"
            loading={index < 2 ? "eager" : "lazy"}
            class="block h-auto w-full"
          />
          {photo.caption && (
            <>
              <figcaption class="photo-caption pointer-events-none absolute inset-x-0 top-0 bg-gradient-to-b from-black/60 to-transparent px-6 pt-5 pb-14 text-center font-sans text-sm font-light text-white/90">
                {splitCaption(photo.caption).top}
              </figcaption>
              {splitCaption(photo.caption).bottom && (
                <figcaption class="photo-caption pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent px-6 pt-14 pb-5 font-sans text-sm font-light text-white/90">
                  {photo.djiTime ? (
                    <div class="grid grid-cols-3 items-center">
                      <span class="text-left">{photo.djiDate}</span>
                      <span class="text-center">{splitCaption(photo.caption).bottom}</span>
                      <span class="text-right">{photo.djiTime}</span>
                    </div>
                  ) : (
                    <div class="text-center">{splitCaption(photo.caption).bottom}</div>
                  )}
                </figcaption>
              )}
            </>
          )}
          <span class="viewfinder-corner viewfinder-corner--tl" aria-hidden="true"></span>
          <span class="viewfinder-corner viewfinder-corner--tr" aria-hidden="true"></span>
          <span class="viewfinder-corner viewfinder-corner--bl" aria-hidden="true"></span>
          <span class="viewfinder-corner viewfinder-corner--br" aria-hidden="true"></span>
        </figure>
      ))}
      </div>
      ))}
    </div>
  </section>
  <dialog id="portrait-view" aria-label="Washington Square Park photograph">
    <div class="portrait-stage">
      <Image src={photo0} alt={photos[0].alt} widths={[800, 1200, 1600]} sizes="90vw" format="webp" class="portrait-large" />
      <p class="portrait-label">
        <span class="block">{splitCaption(photos[0].caption).top}</span>
        {splitCaption(photos[0].caption).bottom && (
          <span class="block">{splitCaption(photos[0].caption).bottom}</span>
        )}
      </p>
      <button type="button" class="portrait-close" aria-label="Close enlarged photo" autofocus>×</button>
    </div>
    <button type="button" class="portrait-nav portrait-prev" aria-label="Previous photo">‹</button>
    <button type="button" class="portrait-nav portrait-next" aria-label="Next photo">›</button>
    <p class="portrait-position" aria-live="polite" aria-atomic="true"></p>
  </dialog>
</Layout>

<script>
  const triggers = document.querySelectorAll<HTMLElement>("[data-expand-portrait]");
  let trigger: HTMLElement | undefined;
  let openingCard: HTMLElement | undefined;
  let sequence: HTMLElement[] = [];
  const viewer = document.querySelector<HTMLDialogElement>("#portrait-view");
  const stage = viewer?.querySelector<HTMLElement>(".portrait-stage");
  let oldOverflow = "";
  let closing = false;
  let openedWithKeyboard = false;
  let motion: Animation | undefined;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  function thumbnailTransform() {
    const source = trigger?.querySelector("img")?.getBoundingClientRect();
    const target = viewer?.querySelector(".portrait-large")?.getBoundingClientRect();
    if (!source || !target) return "none";
    return `translate(${source.left - target.left}px, ${source.top - target.top}px) scale(${source.width / target.width}, ${source.height / target.height})`;
  }
  function closePortrait() {
    if (!viewer?.open || !stage || closing) return;
    closing = true;
    motion?.finish();
    const destination = thumbnailTransform();
    viewer.classList.add("is-closing");
    motion = stage.animate([{ transform: "none" }, { transform: destination }], {
      duration: reducedMotion.matches ? 0 : 300,
      easing: "cubic-bezier(0.4, 0, 0.2, 1)", fill: "forwards",
    });
    motion.onfinish = () => {
      viewer.close();
      motion?.cancel();
    };
  }
  function showPhoto(card: HTMLElement) {
    if (!viewer || !stage) return;
    const thumbnail = card.querySelector("img");
    const enlarged = viewer.querySelector<HTMLImageElement>(".portrait-large");
    if (!thumbnail || !enlarged) return;
    trigger = card;
    enlarged.srcset = thumbnail.srcset;
    enlarged.sizes = "90vw";
    enlarged.src = thumbnail.src;
    enlarged.alt = thumbnail.alt;
    enlarged.width = thumbnail.width;
    enlarged.height = thumbnail.height;
    const ratio = Number(thumbnail.getAttribute("width")) / Number(thumbnail.getAttribute("height"));
    stage.style.width = `min(90vw, ${88 * ratio}dvh)`;
    const label = viewer.querySelector<HTMLElement>(".portrait-label");
    if (label) {
      const caption = card.dataset.caption ?? "";
      const commaIndex = caption.indexOf(",");
      const top = commaIndex === -1 ? caption : caption.slice(0, commaIndex);
      const bottom = commaIndex === -1 ? "" : caption.slice(commaIndex + 1).trim();
      label.innerHTML = "";
      const topSpan = document.createElement("span");
      topSpan.className = "block";
      topSpan.textContent = top;
      label.append(topSpan);
      if (bottom) {
        const bottomSpan = document.createElement("span");
        bottomSpan.className = "block";
        bottomSpan.textContent = bottom;
        label.append(bottomSpan);
      }
    }
    viewer.setAttribute("aria-label", card.dataset.caption || thumbnail.alt || "Enlarged photograph");
    const position = viewer.querySelector<HTMLElement>(".portrait-position");
    if (position) position.textContent = `${sequence.indexOf(card) + 1} / ${sequence.length}`;
    viewer.querySelectorAll<HTMLButtonElement>(".portrait-nav").forEach(button => {
      button.hidden = sequence.length < 2;
    });
  }
  function openPortrait(card: HTMLElement) {
    if (!viewer || viewer.open || !stage) return;
    openingCard = card;
    const selectedFilter = document.querySelector('[role="tab"][aria-selected="true"]')?.closest<HTMLElement>("[data-filter]")?.dataset.filter;
    sequence = Array.from(triggers).filter(item => !selectedFilter || item.dataset.tags?.split(" ").includes(selectedFilter));
    if (!sequence.includes(card)) sequence = [card];
    showPhoto(card);
    closing = false;
    viewer.classList.remove("is-closing");
    oldOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    viewer.showModal();
    if (stage && trigger) {
      const origin = thumbnailTransform();
      trigger.style.visibility = "hidden";
      motion = stage.animate([{ transform: origin }, { transform: "none" }], {
        duration: reducedMotion.matches ? 0 : 420,
        easing: "cubic-bezier(0.22, 1, 0.36, 1)", fill: "both",
      });
    }
  }
  function navigatePhoto(direction: number) {
    if (!viewer?.open || closing || !trigger || sequence.length < 2) return;
    motion?.cancel();
    trigger.style.visibility = "";
    const next = sequence[(sequence.indexOf(trigger) + direction + sequence.length) % sequence.length];
    showPhoto(next);
    next.style.visibility = "hidden";
    // Animate only the image so repeated navigation keeps the controls steady.
    viewer.querySelector(".portrait-large")?.getAnimations().forEach(animation => animation.cancel());
    viewer.querySelector(".portrait-large")?.animate([{ opacity: 0.45 }, { opacity: 1 }], {
      duration: reducedMotion.matches ? 0 : 180,
      easing: "ease-out",
    });
  }
  viewer?.addEventListener("keydown", event => {
    if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
      event.preventDefault();
      navigatePhoto(event.key === "ArrowLeft" ? -1 : 1);
    }
  });
  viewer?.querySelector(".portrait-prev")?.addEventListener("click", () => navigatePhoto(-1));
  viewer?.querySelector(".portrait-next")?.addEventListener("click", () => navigatePhoto(1));
  let selectedCard: HTMLElement | undefined;
  function selectCard(card: HTMLElement) {
    selectedCard?.classList.remove("is-selected");
    selectedCard?.setAttribute("aria-pressed", "false");
    selectedCard = card;
    card.classList.add("is-selected");
    card.setAttribute("aria-pressed", "true");
    card.focus({ preventScroll: true });
  }
  function moveSelection(card: HTMLElement, key: string) {
    const rect = card.getBoundingClientRect();
    const horizontal = key === "ArrowLeft" || key === "ArrowRight";
    const sign = key === "ArrowLeft" || key === "ArrowUp" ? -1 : 1;
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;
    const candidates = Array.from(triggers).filter(item => item !== card && !item.hidden).map(item => {
      const r = item.getBoundingClientRect();
      const dx = r.left + r.width / 2 - x;
      const dy = r.top + r.height / 2 - y;
      const forward = (horizontal ? dx : dy) * sign;
      const cross = Math.abs(horizontal ? dy : dx);
      return { item, forward, score: forward + cross * 3 };
    }).filter(candidate => candidate.forward > 10).sort((a, b) => a.score - b.score);
    if (candidates[0]) {
      selectCard(candidates[0].item);
      candidates[0].item.scrollIntoView({ block: "nearest", behavior: "instant" });
    }
  }
  triggers.forEach((card) => {
    card.setAttribute("aria-pressed", "false");
    card.setAttribute("aria-label", `Select ${card.dataset.caption || card.querySelector("img")?.alt || "photo"}`);
    card.addEventListener("click", () => selectCard(card));
    card.addEventListener("dblclick", () => {
      openedWithKeyboard = false;
      openPortrait(card);
    });
    // Map popups explicitly request enlargement without changing gallery click behaviour.
    card.addEventListener("photo:open", () => {
      selectCard(card);
      openedWithKeyboard = false;
      openPortrait(card);
    });
    card.addEventListener("keydown", (event) => {
      if (viewer?.open) return;
      if (["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight"].includes(event.key)) {
        event.preventDefault();
        moveSelection(card, event.key);
      } else if (event.key === "Enter") {
        event.preventDefault();
        selectCard(card);
        openedWithKeyboard = true;
        openPortrait(card);
      } else if (event.key === " ") {
        event.preventDefault();
        selectCard(card);
      } else if (event.key === "Escape") {
        selectedCard?.classList.remove("is-selected");
        selectedCard?.setAttribute("aria-pressed", "false");
        selectedCard = undefined;
        card.blur();
      }
    });
  });
  viewer?.querySelector(".portrait-close")?.addEventListener("click", () => closePortrait());
  viewer?.addEventListener("click", (event) => {
    if (event.target === viewer) closePortrait();
  });
  viewer?.addEventListener("cancel", (event) => {
    event.preventDefault();
    closePortrait();
  });
  viewer?.addEventListener("close", () => {
    if (trigger) trigger.style.visibility = "";
    document.body.style.overflow = oldOverflow;
    if (openedWithKeyboard) openingCard?.focus({ preventScroll: true });
    else openingCard?.focus({ preventScroll: true });
  });
</script>

<style is:inline>
  [data-expand-portrait] { cursor: pointer; }
  #portrait-view {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }
  #portrait-view[open] { display: grid; place-items: center; }
  #portrait-view::backdrop {
    background: rgb(0 0 0 / 88%);
    backdrop-filter: blur(6px);
    animation: backdrop-in 200ms ease both;
  }
  .portrait-stage {
    position: relative;
    width: min(90vw, 49.5dvh);
    transform-origin: top left;
  }
  .portrait-large { display: block; width: 100%; height: auto; max-height: 88dvh; object-fit: contain; border-radius: 12px; }
  .portrait-label { position: absolute; bottom: 0; inset-inline: 0; padding: 48px 24px 20px; background: linear-gradient(transparent, rgb(0 0 0 / 60%)); color: rgb(255 255 255 / 90%); font-size: 14px; font-weight: 300; border-radius: 0 0 12px 12px; }
  .portrait-close { position: absolute; right: 12px; top: 12px; display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; padding: 0; border: none; border-radius: 50%; background: rgb(0 0 0 / 45%); color: white; font-size: 24px; line-height: 1; cursor: pointer; }
  .portrait-nav { position: absolute; top: 50%; transform: translateY(-50%); width: 48px; height: 56px; display: grid; place-items: center; padding: 0; border: 0; border-radius: 28px; background: rgb(0 0 0 / 55%); color: white; font-size: 38px; line-height: 1; cursor: pointer; touch-action: manipulation; }
  .portrait-nav[hidden] { display: none; }
  .portrait-prev { left: max(8px, env(safe-area-inset-left)); }
  .portrait-next { right: max(8px, env(safe-area-inset-right)); }
  .portrait-nav:focus-visible, .portrait-close:focus-visible { outline: 2px solid white; outline-offset: 3px; }
