---
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle light and dark mode"
  class="fixed bottom-6 left-6 z-50 flex h-11 w-11 items-center justify-center rounded-full border border-line bg-ink-soft text-paper-dim shadow-lg transition-colors hover:text-accent"
>
  <svg
    id="theme-icon-sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    width="18"
    height="18"
    class="hidden"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <line x1="12" y1="2" x2="12" y2="4"></line>
    <line x1="12" y1="20" x2="12" y2="22"></line>
    <line x1="4" y1="12" x2="2" y2="12"></line>
    <line x1="22" y1="12" x2="20" y2="12"></line>
    <line x1="19.07" y1="4.93" x2="17.66" y2="6.34"></line>
    <line x1="6.34" y1="17.66" x2="4.93" y2="19.07"></line>
    <line x1="19.07" y1="19.07" x2="17.66" y2="17.66"></line>
    <line x1="6.34" y1="6.34" x2="4.93" y2="4.93"></line>
  </svg>
  <svg
    id="theme-icon-moon"
    viewBox="0 0 24 24"
    fill="currentColor"
    width="18"
    height="18"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const button = document.getElementById("theme-toggle");
  const sun = document.getElementById("theme-icon-sun");
  const moon = document.getElementById("theme-icon-moon");

  function currentTheme(): "light" | "dark" {
    return root.getAttribute("data-theme") === "light" ? "light" : "dark";
  }

  function reflect(theme: "light" | "dark") {
    sun?.classList.toggle("hidden", theme !== "light");
    moon?.classList.toggle("hidden", theme === "light");
    button?.setAttribute("aria-pressed", String(theme === "light"));
  }

  reflect(currentTheme());

  button?.addEventListener("click", () => {
    const next = currentTheme() === "light" ? "dark" : "light";
    if (next === "light") {
      root.setAttribute("data-theme", "light");
    } else {
      root.removeAttribute("data-theme");
    }
    localStorage.setItem("theme", next);
    reflect(next);
  });
</script>
