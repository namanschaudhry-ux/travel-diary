---
import NameArc from "./NameArc.astro";
import NameOrbit from "./NameOrbit.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

// Trip pages and their accents (dark and light theme values from each page),
// used to colour the name logo on that trip's page.
const photoLinks = [
  { slug: "melbourne", label: "Melbourne Spring '26", dark: "#c5e063", light: "#4f7a12" },
  { slug: "san-francisco", label: "San Francisco Summer '26", dark: "#ffd60a", light: "#806600" },
  { slug: "new-york", label: "New York City Summer '26", dark: "#ffd60a", light: "#8a6642" },
  { slug: "nyc-preview", label: "NYC Preview", dark: "#ffd60a", light: "#8a6642" },
  { slug: "new-zealand", label: "New Zealand Winter '26", dark: "#8fd4ff", light: "#1a73a8" },
  { slug: "melbourne-autumn", label: "Melbourne Autumn '26", dark: "#f4a259", light: "#95501a" },
  { slug: "new-zealand-autumn", label: "New Zealand Autumn '26", dark: "#f4a259", light: "#a8521a" },
  { slug: "japan", label: "Japan Winter '25", dark: "#8fd4ff", light: "#1a73a8" },
];
// On a trip page the name logo stays in that trip's colour, not only on hover.
const currentTrip = photoLinks.find((link) => path === `/photos/${link.slug}`);
// Products menu: things I've made that live on their own sites.
const productLinks = [
  { href: "https://melbourne-marathon-keepsake.vercel.app/", label: "Gallery 42", dark: "#ff5a4f", light: "#c41a10" },
];
---

<header class="sticky top-0 z-50 border-b border-line/70 bg-ink/90 backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5 sm:px-10">
    {/* The homepage has the arched name over the watch, so the brand only shows on other pages. */}
    {path === "/" ? (
      <span aria-hidden="true"></span>
    ) : (
      <a
        href="/"
        aria-label="Naman, home"
        class="brand-logo -my-2 block transition-colors"
        style={currentTrip ? `--logo-dark: ${currentTrip.dark}; --logo-light: ${currentTrip.light};` : undefined}
      >
        {/* The Moving pages use the serif orbit wordmark; everywhere else keeps the arched name. */}
        {path === "/moving" || path.startsWith("/moving/") ? <NameOrbit /> : <NameArc variant="logo" />}
      </a>
    )}

    <input type="checkbox" id="nav-toggle" class="peer hidden" />
    <label
      for="nav-toggle"
      class="cursor-pointer text-sm lowercase text-paper sm:hidden"
      aria-label="Toggle navigation"
    >
      menu
    </label>

    <nav
      class="hidden gap-8 text-sm lowercase text-paper-dim peer-checked:flex peer-checked:flex-col peer-checked:gap-4 peer-checked:absolute peer-checked:left-0 peer-checked:right-0 peer-checked:top-full peer-checked:border-b peer-checked:border-line/70 peer-checked:bg-ink peer-checked:px-6 peer-checked:py-6 sm:static sm:flex sm:flex-row sm:border-none sm:bg-transparent sm:px-0 sm:py-0"
    >
      {/* Photos goes straight to the photos page (the SD card case of every trip). */}
      <a
        href="/photos/"
        class:list={[
          "transition-colors hover:text-accent",
          (path === "/photos" || path.startsWith("/photos/")) && "text-accent",
        ]}
      >
        Photos
      </a>
      <a
        href="/moving/"
        class:list={[
          "transition-colors hover:text-accent",
          path === "/moving" && "text-accent",
        ]}
      >
        Moving
      </a>
      <details class="nav-dropdown relative">
        <summary class="flex cursor-pointer list-none items-center gap-2 transition-colors hover:text-accent">
          Products
          <svg class="country-chevron h-3 w-3 transition-transform" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="m3 4.5 3 3 3-3" stroke="currentColor" stroke-width="1.2" /></svg>
        </summary>
        <div class="mt-3 min-w-40 rounded-[12px] border border-line bg-ink p-2 shadow-lg sm:absolute sm:left-0 sm:top-full">
          {productLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noopener" style={`--item-dark: ${link.dark}; --item-light: ${link.light};`} class="trip-link block whitespace-nowrap rounded-lg px-4 py-2 transition-colors">{link.label} ↗</a>
          ))}
        </div>
      </details>

    </nav>
  </div>
</header>

<style>
  summary::-webkit-details-marker { display: none; }
  details[open] .country-chevron { transform: rotate(180deg); }
  .trip-link { --item: var(--item-dark); }
  :global(:root[data-theme="light"]) .trip-link { --item: var(--item-light); }
  .trip-link:hover, .trip-link:focus-visible, .trip-link[aria-current="page"] { color: var(--item); }
  /* Name logo: the current trip's colour on trip pages, otherwise paper. */
  .brand-logo { --logo: var(--logo-dark); color: var(--logo, var(--color-paper)); }
  :global(:root[data-theme="light"]) .brand-logo { --logo: var(--logo-light); }
  .brand-logo:hover { color: var(--color-accent); }
</style>
<script>
  const dropdowns = document.querySelectorAll<HTMLDetailsElement>(".nav-dropdown");
  // Clicking anywhere outside a menu closes it (so opening one closes the other).
  document.addEventListener("click", (event) => {
    dropdowns.forEach((dropdown) => {
      if (event.target instanceof Node && !dropdown.contains(event.target)) dropdown.removeAttribute("open");
    });
  });
  dropdowns.forEach((dropdown) => dropdown.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      dropdown.open = false;
      dropdown.querySelector("summary")?.focus();
    }
  }));
</script>
