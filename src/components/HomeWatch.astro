---
import NameArc from './NameArc.astro';
import { cityActivity, activityTotals as totals } from '../data/activity-summary';
// Count trip assets, excluding unused starter destination galleries.
const images = import.meta.glob(['../assets/photos/**/*.{jpg,jpeg,JPG,JPEG,png,webp}', '!../assets/photos/{japan,italy,iceland}/**/*'], { eager: false });
const number = (n: number) => new Intl.NumberFormat('en', { maximumFractionDigits: 1 }).format(n);
// Distance totals are the same ones shown on the moving page.
const stats = [
 { label: 'photos uploaded', value: String(Object.keys(images).length), unit: 'frames', href: '/photos/' },
 { label: 'kms run · all time', value: number(totals.run), unit: 'km', href: '/moving/' },
 { label: 'kms cycled · all time', value: number(totals.cycle), unit: 'km', href: '/moving/' },
 { label: 'kms swum · all time', value: number(totals.swim), unit: 'km', href: '/moving/' },
 { label: 'cities visited', value: String(cityActivity.length), unit: 'places', href: '/moving/' },
];
---
<section class="watch-home" aria-label="Naman's watch">
  <h1 class="sr-only">Naman</h1>
  <div class="watch-body" data-stats={JSON.stringify(stats)}>
    <span class="watch-cap cap-previous" aria-hidden="true"></span>
    <span class="watch-cap cap-next" aria-hidden="true"></span>
    <NameArc />
    <img class="watch-product" src="/images/instinct-teal-front.png" alt="Garmin Instinct watch with a teal strap" width="1254" height="1254" fetchpriority="high" />
    <button class="watch-button previous" aria-label="Previous statistic" title="Previous statistic"></button>
    <button class="watch-button next" aria-label="Next statistic" title="Next statistic"></button>
    <div class="watch-bezel">
      <div class="watch-screen">
        <p class="watch-date"><span class="weekday">---</span><span class="day">--</span></p>
        <div class="watch-clock" aria-label="Your local time"><span class="hours">--:--</span><span class="seconds">--</span></div>
        <p class="clock-zone">local time</p>
        <a class="watch-stat" href={stats[0].href} aria-live="polite" aria-atomic="true">
          <span class="stat-label">{stats[0].label}</span>
          <span class="stat-number">{stats[0].value}<small>{stats[0].unit}</small></span>
        </a>
        <div class="watch-dots" aria-hidden="true">{stats.map((_, i) => <span class:list={{ active: i === 0 }} />)}</div>
      </div>
    </div>
  </div>
  <div class="turtle-track" aria-hidden="true"><span class="turtle"></span></div>
  <nav class="home-links" aria-label="Explore"><a href="/photos/">photos ↗</a><a href="/moving/">moving ↗</a></nav>
</section>
<script>
 const watch = document.querySelector<HTMLElement>('.watch-body');
 if (watch) {
  const stats = JSON.parse(watch.dataset.stats!);
  let index = 0;
  const change = (step: number) => {
   index = (index + step + stats.length) % stats.length;
   const stat = stats[index];
   watch.querySelector('.stat-label')!.textContent = stat.label;
   const value = watch.querySelector('.stat-number')!;
   value.replaceChildren(document.createTextNode(stat.value));
   const unit = document.createElement('small'); unit.textContent = stat.unit; value.append(unit);
   watch.querySelector<HTMLAnchorElement>('.watch-stat')!.href = stat.href;
   watch.querySelectorAll('.watch-dots span').forEach((dot, i) => dot.classList.toggle('active', i === index));
  };
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Push the physical-looking button cap in and back out.
  const press = (cap: Element | null) => {
   if (!cap) return;
   cap.classList.remove('pressing');
   void (cap as HTMLElement).offsetWidth;
   cap.classList.add('pressing');
  };
  watch.querySelectorAll('.watch-cap').forEach((cap) => cap.addEventListener('animationend', () => cap.classList.remove('pressing')));
  const statEl = watch.querySelector<HTMLElement>('.watch-stat')!;
  const rotate = (step: number) => {
   if (calm) { change(step); return; }
   change(step);
   statEl.getAnimations().forEach((a) => a.cancel());
   statEl.animate([{ opacity: 0, transform: `translateY(${step * 8}px)` }, { opacity: 1, transform: 'translateY(0)' }], { duration: 260, easing: 'cubic-bezier(.2,.7,.2,1)' });
  };
  watch.querySelector('.previous')?.addEventListener('click', () => { press(watch.querySelector('.cap-previous')); rotate(-1); });
  watch.querySelector('.next')?.addEventListener('click', () => { press(watch.querySelector('.cap-next')); rotate(1); });
  const tick = () => {
   const now = new Date();
   watch.querySelector('.hours')!.textContent = now.toLocaleTimeString('en-GB', { hour:'2-digit', minute:'2-digit' });
   watch.querySelector('.seconds')!.textContent = String(now.getSeconds()).padStart(2,'0');
   watch.querySelector('.weekday')!.textContent = now.toLocaleDateString('en-GB', { weekday:'short' });
   watch.querySelector('.day')!.textContent = String(now.getDate());
  };
  let timer: ReturnType<typeof setInterval> | undefined;
  const resume = () => { clearInterval(timer); if (!document.hidden) { tick(); timer = setInterval(tick, 1000); } };
  document.addEventListener('visibilitychange', resume);
  window.addEventListener('pagehide', () => clearInterval(timer));
  window.addEventListener('pageshow', resume);
  resume();
 }
</script>
<style>
 .watch-home { min-height:80vh; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:32px 12px; gap:12px; }
 .watch-body { position:relative; width:min(720px,100%); aspect-ratio:1; container-type:inline-size; }
 .watch-product { position:relative; z-index:1; display:block; width:100%; height:auto; }
 .watch-bezel,.watch-screen { position:absolute; inset:0; z-index:2; pointer-events:none; font-family:"Arial Narrow",Arial,sans-serif; color:#d3d5d0; }
 .watch-date { position:absolute; left:54.5%; top:33.3%; width:10%; height:8%; margin:0; display:flex; flex-direction:column; align-items:center; justify-content:center; color:#141916; font-weight:800; font-style:italic; line-height:1;  }
 .weekday { text-transform:uppercase; font-size:2.5cqw; } .day { font-size:4.5cqw; }
 .watch-clock { position:absolute; left:35%; top:45%; width:30%; white-space:nowrap; font-size:8.5cqw; font-weight:800; font-stretch:condensed; line-height:1; letter-spacing:-.055em;  font-variant-numeric:tabular-nums; }
 .seconds { font-size:2.8cqw; vertical-align:top; margin-left:1cqw; letter-spacing:0; }
 .clock-zone { position:absolute; top:41.5%; left:36%; margin:0; text-transform:uppercase; font-size:1.5cqw; letter-spacing:.14em;  }
 .watch-stat { position:absolute; top:53.5%; left:37%; width:26%; text-align:center; text-decoration:none; color:inherit; display:flex; flex-direction:column; pointer-events:auto;  }
 .stat-label { font-size:1.5cqw; text-transform:uppercase; letter-spacing:.04em; opacity:.8; }
 .stat-number { font-size:5.2cqw; line-height:1; font-weight:800; font-stretch:condensed; letter-spacing:-.04em; font-variant-numeric:tabular-nums; margin-top:.4cqw; }
 .stat-number :global(small) { font-size:1.6cqw; margin-left:.6cqw; letter-spacing:0; font-weight:700; }
 .watch-dots { position:absolute; top:37%; left:42%; display:flex; gap:.6cqw;  }
 .watch-dots span { width:.5cqw; height:.5cqw; border-radius:50%; background:#59605a; } .watch-dots .active { background:#d3d5d0; }
 .watch-button { position:absolute; z-index:3; padding:0; border:0; background:transparent; cursor:pointer; min-width:34px; min-height:44px; touch-action:manipulation; border-radius:12px; }
 .previous { left:15%; top:40.5%; width:7%; height:10.5%; } .next { left:78%; top:40.5%; width:7%; height:10.5%; }
 /* Middle side buttons: a cap sits under the case and pokes out past the edge. */
 .watch-cap { position:absolute; z-index:0; top:41.8%; height:7.8%; width:3.4%; pointer-events:none;
  background:repeating-linear-gradient(0deg,#ffffff0d 0 .22cqw,transparent .22cqw .5cqw),linear-gradient(90deg,#3b3f3d,#1c1f1e 55%,#0d0f0e);
  box-shadow:0 .4cqw .9cqw #0007, inset 0 .15cqw .1cqw #ffffff1f, inset 0 -.2cqw .2cqw #0008;
  transition:transform .18s ease, filter .18s ease; }
 .cap-previous { left:16.6%; border-radius:1.2cqw .4cqw .4cqw 1.2cqw; }
 .cap-next { left:79.6%; border-radius:.4cqw 1.2cqw 1.2cqw .4cqw; background:repeating-linear-gradient(0deg,#ffffff0d 0 .22cqw,transparent .22cqw .5cqw),linear-gradient(270deg,#3b3f3d,#1c1f1e 55%,#0d0f0e); }
 .watch-body:has(.previous:hover) .cap-previous { transform:translateX(-.25cqw); filter:brightness(1.25); }
 .watch-body:has(.next:hover) .cap-next { transform:translateX(.25cqw); filter:brightness(1.25); }
 .cap-previous.pressing { animation:press-previous .28s cubic-bezier(.3,.7,.3,1); }
 .cap-next.pressing { animation:press-next .28s cubic-bezier(.3,.7,.3,1); }
 @keyframes press-previous { 0% { transform:translateX(0); } 35% { transform:translateX(1.3cqw); filter:brightness(.75); } 100% { transform:translateX(0); } }
 @keyframes press-next { 0% { transform:translateX(0); } 35% { transform:translateX(-1.3cqw); filter:brightness(.75); } 100% { transform:translateX(0); } }
 @media (prefers-reduced-motion: reduce) { .watch-cap { transition:none; } .watch-cap.pressing { animation-duration:.01s; } }
 .watch-button:focus-visible,.watch-stat:focus-visible { outline:2px solid #65aaa3; outline-offset:3px; }
 .home-links { display:flex; gap:28px; font:12px monospace; color:var(--color-paper-dim); } .home-links a:hover { color:var(--color-accent); }
 /* Turtle under the watch: own your slow. Coloured by the theme via a mask. */
 .turtle-track { display:flex; justify-content:center; width:min(720px,100%); height:clamp(44px,9vw,72px); }
 .turtle { display:block; height:100%; aspect-ratio:610/270; background:var(--color-paper); opacity:.9;
  -webkit-mask:url('/images/turtle.png') center/contain no-repeat; mask:url('/images/turtle.png') center/contain no-repeat; }
</style>
