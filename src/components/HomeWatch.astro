---
import activity from '../data/strava-export.json';
import { cityActivity } from '../data/activity-summary';
const images = import.meta.glob(['../assets/photos/new-york/**/*.{jpg,jpeg,png,webp}', '../assets/photos/featured/*.{jpg,jpeg,png,webp}'], { eager: false });
const sum = (types: string[]) => activity.activities.filter(a => types.includes(a.sport_type)).reduce((n, a) => n + a.distance_km, 0);
const number = (n: number) => new Intl.NumberFormat('en', { maximumFractionDigits: 1 }).format(n);
const stats = [
 { label: 'photos uploaded', value: String(Object.keys(images).length), unit: 'frames', note: 'in the photo collection', href: '/photos/new-york/' },
 { label: 'kms run · 2026', value: number(sum(['Run', 'TrailRun', 'VirtualRun'])), unit: 'km', note: '15 Jun–15 Sep · partial year', href: '/moving/' },
 { label: 'kms cycled · 2026', value: number(sum(['Ride', 'VirtualRide', 'GravelRide', 'MountainBikeRide'])), unit: 'km', note: '15 Jun–15 Sep · partial year', href: '/moving/' },
 { label: 'kms swum · 2026', value: number(sum(['Swim'])), unit: 'km', note: '15 Jun–15 Sep · partial year', href: '/moving/' },
 { label: 'cities visited', value: String(cityActivity.length), unit: 'places', note: 'recorded locations since 2023', href: '/moving/' },
];
---
<section class="watch-home" aria-label="Naman's watch">
  <h1 class="watch-intro">a little of my world</h1>
  <div class="watch-body" data-stats={JSON.stringify(stats)}>
    <div class="strap strap-top" aria-hidden="true"></div>
    <div class="strap strap-bottom" aria-hidden="true"></div>
    <button class="watch-button previous" aria-label="Previous statistic" title="Previous statistic"></button>
    <button class="watch-button next" aria-label="Next statistic" title="Next statistic"></button>
    <div class="watch-bezel">
      <span class="bezel-name">NAMAN</span>
      <div class="watch-screen">
        <svg class="watch-ring" viewBox="0 0 400 400" aria-hidden="true"><circle cx="200" cy="200" r="185" /></svg>
        <p class="watch-date">TODAY</p>
        <div class="watch-clock" aria-label="Your local time"><span class="hours">--:--</span><span class="seconds">--</span></div>
        <p class="clock-zone">local time</p>
        <a class="watch-stat" href={stats[0].href} aria-live="polite" aria-atomic="true">
          <span class="stat-label">{stats[0].label}</span>
          <span class="stat-number">{stats[0].value}<small>{stats[0].unit}</small></span>
          <span class="stat-note">{stats[0].note}</span>
        </a>
        <div class="watch-dots" aria-hidden="true">{stats.map((_, i) => <span class:list={{ active: i === 0 }} />)}</div>
      </div>
      <span class="bezel-bottom">EXPLORE / EVERY DAY</span>
    </div>
  </div>
  <nav class="home-links" aria-label="Explore"><a href="/photos/new-york/">photos ↗</a><a href="/moving/">moving ↗</a><a href="/about/">working ↗</a></nav>
</section>
<script>
 const watch = document.querySelector<HTMLElement>('.watch-body');
 if (watch) {
  const stats = JSON.parse(watch.dataset.stats!);
  let index = 0;
  const change = (step: number) => {
   index = (index + step + stats.length) % stats.length;
   const stat = stats[index];
   watch.querySelector('.stat-label')!.textContent = stat.label;
   const value = watch.querySelector('.stat-number')!;
   value.replaceChildren(document.createTextNode(stat.value));
   const unit = document.createElement('small'); unit.textContent = stat.unit; value.append(unit);
   watch.querySelector('.stat-note')!.textContent = stat.note;
   watch.querySelector<HTMLAnchorElement>('.watch-stat')!.href = stat.href;
   watch.querySelectorAll('.watch-dots span').forEach((dot, i) => dot.classList.toggle('active', i === index));
  };
  watch.querySelector('.previous')?.addEventListener('click', () => change(-1));
  watch.querySelector('.next')?.addEventListener('click', () => change(1));
  const tick = () => {
   const now = new Date();
   watch.querySelector('.hours')!.textContent = now.toLocaleTimeString('en-GB', { hour:'2-digit', minute:'2-digit' });
   watch.querySelector('.seconds')!.textContent = String(now.getSeconds()).padStart(2,'0');
   watch.querySelector('.watch-date')!.textContent = now.toLocaleDateString('en-GB', { weekday:'short', day:'numeric', month:'short' });
  };
  let timer: ReturnType<typeof setInterval> | undefined;
  const resume = () => { clearInterval(timer); if (!document.hidden) { tick(); timer = setInterval(tick, 1000); } };
  document.addEventListener('visibilitychange', resume);
  window.addEventListener('pagehide', () => clearInterval(timer));
  window.addEventListener('pageshow', resume);
  resume();
 }
</script>
<style>
 .watch-home { min-height: 80vh; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:36px 24px 44px; gap:28px; }
 .watch-intro { font:12px monospace; letter-spacing:.2em; color:var(--color-paper-dim); text-transform:uppercase; }
 .watch-body { position:relative; width:min(440px, 78vw); aspect-ratio:1; margin:62px 0; isolation:isolate; }
 .strap { position:absolute; z-index:-1; width:40%; height:30%; left:30%; background:linear-gradient(90deg,#7a8282 0%,#aab0ad 8%,#c1c5bf 25%,#b5bab4 66%,#929a96 94%,#737e79); border:1px solid #969f99; box-shadow:inset 3px 0 4px #e4e7dc55,inset -4px 0 8px #34413b66,0 12px 20px #0004; border-radius:30% 30% 16% 16% / 12% 12% 8% 8%; }
 .strap-top { top:-15%; } .strap-bottom { bottom:-15%; }
 .strap::after { content:''; position:absolute; width:52%; height:8px; background:linear-gradient(#4f5d55,#78877d); border-radius:10px; left:24%; top:22%; box-shadow:inset 0 2px 3px #0007,0 1px 1px #e1e5d977; }
 .strap-bottom::after { top:auto; bottom:22%; }
 .watch-bezel { position:absolute; inset:0; border-radius:50%; background:conic-gradient(from 35deg,#333638,#222527 22%,#414547 45%,#272b2c 65%,#565b5d 83%,#333638); padding:8%; border:7px solid #7e8787; box-shadow:0 28px 38px #0006,0 5px 9px #0008,inset 0 0 0 2px #121616,inset 2px 3px 3px #cbd4cd55,inset -3px -4px 7px #0008; }
 .watch-screen { position:relative; height:100%; border-radius:50%; background:linear-gradient(145deg,#c6d4cc12,transparent 42%),radial-gradient(ellipse at 40% 20%,#14201c,#030706 75%); box-shadow:inset 0 3px 10px #000,inset 0 0 0 1px #657b6b44; color:#f2f7f4; display:flex; align-items:center; flex-direction:column; justify-content:center; overflow:hidden; font-family:monospace; }
 .watch-ring { position:absolute; inset:3%; width:94%; height:94%; pointer-events:none; transform:rotate(-90deg); }
 .watch-ring circle { fill:none; stroke:#27e5d9; stroke-width:3; stroke-dasharray:965 198; stroke-linecap:round; }
 .bezel-name,.bezel-bottom { position:absolute; left:0; width:100%; text-align:center; font:9px monospace; letter-spacing:.18em; color:#c3cccb; }
 .bezel-name { top:3.5%; } .bezel-bottom { bottom:3.5%; font-size:7px; }
 .watch-date { font-size:clamp(9px,2.5vw,12px); text-transform:uppercase; letter-spacing:.14em; color:#a0b9b3; margin-bottom:8px; }
 .watch-clock { font-size:clamp(36px,10vw,60px); line-height:1; letter-spacing:-.08em; font-variant-numeric:tabular-nums; }
 .seconds { font-size:.3em; color:#27e5d9; margin-left:7px; letter-spacing:0; }
 .clock-zone { font-size:8px; letter-spacing:.15em; color:#829d96; margin:5px 0 13px; }
 .watch-stat { text-align:center; display:flex; align-items:center; flex-direction:column; text-decoration:none; }
 .stat-label { font-size:clamp(9px,2.5vw,12px); color:#ffd65a; }
 .stat-number { font-size:clamp(25px,7vw,40px); line-height:1.3; font-variant-numeric:tabular-nums; }
 .stat-number :global(small) { font-size:10px; margin-left:5px; color:#abc1bb; }
 .stat-note { font-size:clamp(7px,1.9vw,9px); color:#8ba29c; }
 .watch-dots { display:flex; gap:7px; margin-top:12px; } .watch-dots span { width:4px; height:4px; background:#41504c; border-radius:50%; } .watch-dots .active { background:#27e5d9; }
 .watch-button { position:absolute; z-index:2; top:43%; height:14%; width:44px; padding:0; border:0; background:transparent; cursor:pointer; touch-action:manipulation; }
 .watch-button::before { content:''; position:absolute; top:16%; bottom:16%; width:13px; border:1px solid #89908d; border-radius:4px; background:linear-gradient(90deg,#505b57,#9da6a1 28%,#747e78 62%,#414e48); box-shadow:inset 0 2px 2px #e4e8df66,0 3px 4px #0008; transition:transform 120ms ease; }
 .previous { left:-32px; } .next { right:-32px; }
 .previous::before { right:0; transform:rotate(3deg); } .next::before { left:0; transform:rotate(-3deg); }
 .previous:active::before { transform:translateX(3px); } .next:active::before { transform:translateX(-3px); }
 .watch-button:focus-visible,.watch-stat:focus-visible { outline:2px solid #27e5d9; outline-offset:5px; }
 .home-links { display:flex; gap:28px; font:12px monospace; color:var(--color-paper-dim); } .home-links a:hover { color:var(--color-accent); }
</style>
