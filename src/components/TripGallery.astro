      gap: 16px;
    }
    .top-controls .left-controls {
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
    }
    .top-controls .city-title { grid-column: 2; grid-row: 1; }
    .top-controls .filter-dial-wrap {
      grid-column: 1 / -1;
      justify-self: center;
    }
  }

  /* Camera-dial filter selector: a single solid disc (like a Fujifilm
     shutter-speed dial) that rotates so the chosen category lands under the
