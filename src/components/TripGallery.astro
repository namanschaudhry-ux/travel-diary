    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.06),
      inset 0 3px 8px rgba(255, 255, 255, 0.05),
      inset 0 -5px 12px rgba(0, 0, 0, 0.7),
      0 8px 18px rgba(0, 0, 0, 0.45);
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .camera-dial-item {
    position: absolute;
    inset: 0;
    /* Each item covers the whole disc so its label can be positioned by
       rotation, so later items in DOM order would otherwise intercept clicks
       meant for an earlier item's button underneath. */
    pointer-events: none;
  }
  .camera-dial-label {
    pointer-events: auto;
  }
  .camera-dial-label {
    position: absolute;
    /* Icons are compact and uniform in size, so they can sit close to the
       rim (like engraved tabs on a real dial) without the collision/overflow
       issues a variable-width word had at this position. */
    top: 11px;
    left: 50%;
    transform: translateX(-50%) rotate(var(--counter-rot, 0deg));
    display: flex;
    align-items: center;
    justify-content: center;
    appearance: none;
    -webkit-appearance: none;
