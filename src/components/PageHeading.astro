---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="py-20 text-center">
  <h1 class="font-heading text-[72px] leading-none lowercase text-paper sm:text-[80px]">
    {title}
  </h1>
  {
    subtitle && (
      <p class="mx-auto mt-5 max-w-md font-heading text-[20px] italic text-paper-dim">
        {subtitle}
      </p>
    )
  }
</div>
