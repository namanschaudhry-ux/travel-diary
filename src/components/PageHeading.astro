---
interface Props {
  title: string;
  subtitle?: string;
  lowercase?: boolean;
}

const { title, subtitle, lowercase = true } = Astro.props;
---

<div class="py-20 text-center">
  <h1 class:list={["font-heading text-[72px] leading-none text-paper sm:text-[80px]", { lowercase }]}>
    {title}
  </h1>
  {
    subtitle && (
      <p class="mx-auto mt-5 max-w-md font-heading text-[20px] italic text-paper-dim">
        {subtitle}
      </p>
    )
  }
</div>
